@model HTquanlyhoinghi_UNETI2_TI17A3HN.Models.Module4.DangKyPhienChoDuyetViewModel

@{
    ViewData["Title"] = "Duyệt đăng ký phiên";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Duyệt đăng ký phiên</h1>
        <p class="text-muted mb-0">Chỉ đăng ký phiên đã duyệt mới đủ điều kiện điểm danh.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Điểm danh phiên</a>
</div>

@if (Model.KetQua is not null)
{
    <div class="alert @(Model.KetQua.ThanhCong ? "alert-success" : "alert-danger")" role="status">
        @Model.KetQua.ThongBao
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ThongBao))
{
    <div class="alert alert-warning" role="status">@Model.ThongBao</div>
}

<form asp-action="ChoDuyet" method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-9">
            <label for="maPhienSuKien" class="form-label">Phiên sự kiện</label>
            <select id="maPhienSuKien" name="maPhienSuKien" class="form-select" required>
                <option value="">-- Chọn phiên --</option>
                @foreach (var phien in Model.DanhSachPhien)
                {
                    <option value="@phien.MaPhienSuKien" selected="@(phien.MaPhienSuKien == Model.MaPhienSuKien)">
                        @phien.TenHienThi
                    </option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Xem đăng ký</button>
        </div>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.MaPhienSuKien))
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Mã đăng ký</th>
                    <th>Người tham dự</th>
                    <th>Email</th>
                    <th>Phiên</th>
                    <th>Ngày đăng ký</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DanhSachDangKy.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            Không có đăng ký phiên đang chờ duyệt.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var dangKy in Model.DanhSachDangKy)
                    {
                        <tr>
                            <td><code>@dangKy.MaDangKyPhien</code></td>
                            <td>@dangKy.TenNguoiThamDu</td>
                            <td>@dangKy.Email</td>
                            <td>@dangKy.TenPhien</td>
                            <td>@dangKy.NgayDangKy.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="badge text-bg-warning">Chờ duyệt</span></td>
                            <td class="text-end">
                                <form asp-action="DuyetDangKy" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="maDangKyPhien" value="@dangKy.MaDangKyPhien" />
                                    <input type="hidden" name="maPhienSuKien" value="@Model.MaPhienSuKien" />
                                    <button type="submit" class="btn btn-sm btn-success">Duyệt</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}
