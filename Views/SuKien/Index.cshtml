@model IEnumerable<HTquanlyhoinghi_UNETI2_TI17A3HN.Models.SuKien>
@{
    ViewData["Title"] = "Quản lý sự kiện";
}
<h1>Quản lý sự kiện</h1>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-6"><input name="search" value="@ViewBag.Search" class="form-control"
                                     placeholder="Tìm theo tên, mô tả, loại hoặc địa điểm" /></div>
        <div class="col-md-3">
            <select name="trangThai" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="SapDienRa" selected="@(ViewBag.TrangThai == "SapDienRa")">Sắp diễn ra</option>
                <option value="DangDienRa" selected="@(ViewBag.TrangThai == "DangDienRa")">Đang diễn ra</option>
                <option value="DaKetThuc" selected="@(ViewBag.TrangThai == "DaKetThuc")">Đã kết thúc</option>
                <option value="DaHuy" selected="@(ViewBag.TrangThai == "DaHuy")">Đã hủy</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2"><button class="btn btn-primary" type="submit">Tìm kiếm</button><a
            asp-action="Create" class="btn btn-success">Thêm sự kiện</a></div>
        </form>
        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>Tên sự kiện</th>
                    <th>Loại</th>
                    <th>Địa điểm</th>
                    <th>Thời gian</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.TenSuKien</td>
                        <td>@item.LoaiSuKien?.TenLoaiSuKien</td>
                        <td>@item.DiaDiem?.TenDiaDiem</td>
                        <td>@item.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm") - @item.ThoiGianKetThuc.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td>@item.TrangThai</td>
                        <td class="text-nowrap"><a asp-action="Details" asp-route-id="@item.MaSuKien">Chi tiết</a> | <a
                            asp-action="Edit" asp-route-id="@item.MaSuKien">Sửa</a> | <a asp-action="Delete"
                                                                                         asp-route-id="@item.MaSuKien">Xóa</a></td>
                        </tr>
                    }
                </tbody>
            </table>
