@model IEnumerable<HTquanlyhoinghi_UNETI2_TI17A3HN.Models.SuKien>
@{
    ViewData["Title"] = "Quản lý sự kiện";
    var sortBy = ViewBag.SortBy as string ?? "ThoiGianBatDau";
    var sortDescending = ViewBag.SortDescending as bool? ?? true;
    var pageNumber = (int)(ViewBag.PageNumber ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 10);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? Model.Count());
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1>Quản lý sự kiện</h1>
            <p class="mb-0 text-muted">Tìm, lọc và sắp xếp các sự kiện.</p>
        </div>
        <a asp-action="Create" class="btn btn-success">+ Thêm sự kiện</a>
    </div>

    <form method="get" class="row g-3 mb-3">
        <div class="col-md-5">
            <input name="search" value="@ViewBag.Search" class="form-control"
                   placeholder="Tìm sự kiện, loại, địa điểm hoặc phiên" />
        </div>
        <div class="col-md-3">
            <select name="trangThai" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="SapDienRa" selected="@(ViewBag.TrangThai == "SapDienRa")">Sắp diễn ra</option>
                <option value="DangDienRa" selected="@(ViewBag.TrangThai == "DangDienRa")">Đang diễn ra</option>
                <option value="DaKetThuc" selected="@(ViewBag.TrangThai == "DaKetThuc")">Đã kết thúc</option>
                <option value="DaHuy" selected="@(ViewBag.TrangThai == "DaHuy")">Đã hủy</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="maLoaiSuKien" asp-items="ViewBag.LoaiSuKien" class="form-select">
                <option value="">Tất cả loại sự kiện</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="maDiaDiem" asp-items="ViewBag.DiaDiem" class="form-select">
                <option value="">Tất cả địa điểm</option>
            </select>
        </div>
        <div class="col-md-3">
            <label for="ngayBatDauTu" class="form-label">Tổ chức từ ngày</label>
            <input id="ngayBatDauTu" name="ngayBatDauTu" type="date"
                   value="@ViewBag.NgayBatDauTu" class="form-control" />
        </div>
        <div class="col-md-3">
            <label for="ngayBatDauDen" class="form-label">Đến ngày</label>
            <input id="ngayBatDauDen" name="ngayBatDauDen" type="date"
                   value="@ViewBag.NgayBatDauDen" class="form-control" />
        </div>
        <div class="col-md-2">
            <select name="sortBy" class="form-select">
                <option value="ThoiGianBatDau" selected="@(sortBy == "ThoiGianBatDau")">Bắt đầu</option>
                <option value="TenSuKien" selected="@(sortBy == "TenSuKien")">Tên sự kiện</option>
                <option value="ThoiGianKetThuc" selected="@(sortBy == "ThoiGianKetThuc")">Kết thúc</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <select name="sortDescending" class="form-select">
                <option value="true" selected="@(sortDescending)">Giảm dần</option>
                <option value="false" selected="@(!sortDescending)">Tăng dần</option>
            </select>
            <button class="btn btn-primary" type="submit">Lọc &amp; sắp</button>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tên sự kiện</th>
                        <th>Loại sự kiện</th>
                        <th>Địa điểm</th>
                        <th>Thời gian</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.TenSuKien</strong></td>
                                <td>@item.LoaiSuKien?.TenLoaiSuKien</td>
                                <td>@item.DiaDiem?.TenDiaDiem</td>
                                <td>@item.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm") -
                                    @item.ThoiGianKetThuc.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@item.TrangThai</td>
                                    <td class="text-center text-nowrap">
                                        <a asp-action="Phien" asp-route-maSuKien="@item.MaSuKien"
                                           class="btn btn-sm btn-outline-info">Phiên</a>
                                        <a asp-action="Details" asp-route-id="@item.MaSuKien"
                                           class="btn btn-sm btn-outline-primary">Chi tiết</a>
                                        <a asp-action="Edit" asp-route-id="@item.MaSuKien"
                                           class="btn btn-sm btn-outline-secondary">Sửa</a>
                                        <a asp-action="Delete" asp-route-id="@item.MaSuKien"
                                           class="btn btn-sm btn-outline-danger">Xóa</a>
                                    </td>
                                </tr>
                            }
                        }
                    else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">Không có sự kiện nào khớp.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (totalPages > 1)
        {
            <nav class="mt-3" aria-label="Phân trang">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-route-pageNumber="@(pageNumber - 1)" asp-route-search="@ViewBag.Search"
                           asp-route-trangThai="@ViewBag.TrangThai" asp-route-sortBy="@sortBy"
                           asp-route-sortDescending="@sortDescending" asp-route-maLoaiSuKien="@ViewBag.MaLoaiSuKien"
                           asp-route-maDiaDiem="@ViewBag.MaDiaDiem" asp-route-ngayBatDauTu="@ViewBag.NgayBatDauTu"
                           asp-route-ngayBatDauDen="@ViewBag.NgayBatDauDen" asp-route-pageSize="@pageSize">Trước</a>
                    </li>
                    <li class="page-item active"><span class="page-link">Trang @pageNumber / @totalPages</span></li>
                    <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-route-pageNumber="@(pageNumber + 1)" asp-route-search="@ViewBag.Search"
                           asp-route-trangThai="@ViewBag.TrangThai" asp-route-sortBy="@sortBy"
                           asp-route-sortDescending="@sortDescending" asp-route-maLoaiSuKien="@ViewBag.MaLoaiSuKien"
                           asp-route-maDiaDiem="@ViewBag.MaDiaDiem" asp-route-ngayBatDauTu="@ViewBag.NgayBatDauTu"
                           asp-route-ngayBatDauDen="@ViewBag.NgayBatDauDen" asp-route-pageSize="@pageSize">Sau</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
