@model IEnumerable<HTquanlyhoinghi_UNETI2_TI17A3HN.Models.SuKien>
@{
    ViewData["Title"] = "Quản lý sự kiện";
    var sortBy = ViewBag.SortBy as string ?? "ThoiGianBatDau";
    var sortDescending = ViewBag.SortDescending as bool? ?? true;
    var pageNumber = (int)(ViewBag.PageNumber ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 10);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? Model.Count());
    string TenTrangThai(string trangThai) => trangThai switch
    {
        "Nhap" => "Nháp",
        "MoDangKy" => "Mở đăng ký",
        "DongDangKy" => "Đóng đăng ký",
        "DangDienRa" => "Đang diễn ra",
        "HoanThanh" => "Hoàn thành",
        "DaHuy" => "Đã hủy",
        _ => trangThai
    };
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1>Quản lý sự kiện</h1>
            <p class="mb-0 text-muted">Tìm, lọc và sắp xếp các sự kiện.</p>
        </div>
        <a asp-action="Create" class="btn btn-success">+ Thêm sự kiện</a>
    </div>

    @if (TempData["ThongBao"] is string thongBao)
    {
        <div class="alert alert-info" role="alert">@thongBao</div>
    }

    <div class="event-filter-scroll mb-3">
      <form method="get" class="event-filter-form">
        <div class="event-filter-search">
            <label for="eventSearch" class="form-label">Tìm kiếm</label>
            <input id="eventSearch" name="search" value="@ViewBag.Search" class="form-control"
                   placeholder="Tìm sự kiện, loại, địa điểm hoặc phiên" />
        </div>
        <div class="event-filter-status">
            <label for="eventStatus" class="form-label">Trạng thái</label>
            <select id="eventStatus" name="trangThai" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="Nhap" selected="@(ViewBag.TrangThai == "Nhap")">Nháp</option>
                <option value="MoDangKy" selected="@(ViewBag.TrangThai == "MoDangKy")">Mở đăng ký</option>
                <option value="DongDangKy" selected="@(ViewBag.TrangThai == "DongDangKy")">Đóng đăng ký</option>
                <option value="DangDienRa" selected="@(ViewBag.TrangThai == "DangDienRa")">Đang diễn ra</option>
                <option value="HoanThanh" selected="@(ViewBag.TrangThai == "HoanThanh")">Hoàn thành</option>
                <option value="DaHuy" selected="@(ViewBag.TrangThai == "DaHuy")">Đã hủy</option>
            </select>
        </div>
        <div class="event-filter-category">
            <label for="eventCategory" class="form-label">Loại sự kiện</label>
            <select id="eventCategory" name="maLoaiSuKien" asp-items="ViewBag.LoaiSuKien" class="form-select">
                <option value="">Tất cả loại sự kiện</option>
            </select>
        </div>
        <div class="event-filter-venue">
            <label for="eventVenue" class="form-label">Địa điểm</label>
            <select id="eventVenue" name="maDiaDiem" asp-items="ViewBag.DiaDiem" class="form-select">
                <option value="">Tất cả địa điểm</option>
            </select>
        </div>
        <div class="event-filter-date">
            <label for="ngayBatDauTu" class="form-label">Tổ chức từ ngày</label>
            <input id="ngayBatDauTu" name="ngayBatDauTu" type="date"
                   value="@ViewBag.NgayBatDauTu" class="form-control" />
        </div>
        <div class="event-filter-date">
            <label for="ngayBatDauDen" class="form-label">Đến ngày</label>
            <input id="ngayBatDauDen" name="ngayBatDauDen" type="date"
                   value="@ViewBag.NgayBatDauDen" class="form-control" />
        </div>
        <div class="event-filter-deadline">
            <label for="tinhTrangDangKy" class="form-label">Hạn đăng ký</label>
            <select id="tinhTrangDangKy" name="tinhTrangDangKy" class="form-select">
                <option value="">Tất cả</option>
                <option value="ConHan" selected="@(ViewBag.TinhTrangDangKy == "ConHan")">Còn hạn</option>
                <option value="HetHan" selected="@(ViewBag.TinhTrangDangKy == "HetHan")">Đã hết hạn</option>
            </select>
        </div>
        <div class="event-filter-quantity">
            <label for="soLuongTu" class="form-label">Số lượng từ</label>
            <input id="soLuongTu" name="soLuongTu" type="number" min="1"
                   value="@ViewBag.SoLuongTu" class="form-control" />
        </div>
        <div class="event-filter-quantity">
            <label for="soLuongDen" class="form-label">Số lượng đến</label>
            <input id="soLuongDen" name="soLuongDen" type="number" min="1"
                   value="@ViewBag.SoLuongDen" class="form-control" />
        </div>
        <div class="event-filter-sort">
            <label for="eventSortBy" class="form-label">Sắp xếp theo</label>
            <select id="eventSortBy" name="sortBy" class="form-select">
                <option value="ThoiGianBatDau" selected="@(sortBy == "ThoiGianBatDau")">Bắt đầu</option>
                <option value="TenSuKien" selected="@(sortBy == "TenSuKien")">Tên sự kiện</option>
                <option value="HanDangKy" selected="@(sortBy == "HanDangKy")">Hạn đăng ký</option>
                <option value="SoLuongToiDa" selected="@(sortBy == "SoLuongToiDa")">Số lượng</option>
            </select>
        </div>
        <div class="event-filter-actions">
            <label for="eventSortDirection" class="visually-hidden">Thứ tự sắp xếp</label>
            <select id="eventSortDirection" name="sortDescending" class="form-select">
                <option value="true" selected="@(sortDescending)">Giảm dần</option>
                <option value="false" selected="@(!sortDescending)">Tăng dần</option>
            </select>
            <button class="btn btn-primary" type="submit">Lọc &amp; sắp</button>
        </div>
      </form>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tên sự kiện</th>
                        <th>Loại sự kiện</th>
                        <th>Địa điểm</th>
                        <th>Thời gian</th>
                        <th>Hạn đăng ký</th>
                        <th>Số lượng tối đa</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.TenSuKien</strong></td>
                                <td>@item.LoaiSuKien?.TenLoaiSuKien</td>
                                <td>@item.DiaDiem?.TenDiaDiem</td>
                                <td>@item.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm") -
                                    @item.ThoiGianKetThuc.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@item.HanDangKy.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@item.SoLuongToiDa</td>
                                <td>@TenTrangThai(item.TrangThai)</td>
                                <td class="text-center text-nowrap">
                                    <a asp-action="Phien" asp-route-maSuKien="@item.MaSuKien"
                                       class="btn btn-sm btn-outline-info">Phiên</a>
                                    <a asp-action="Details" asp-route-id="@item.MaSuKien"
                                       class="btn btn-sm btn-outline-primary">Chi tiết</a>
                                    <a asp-action="Edit" asp-route-id="@item.MaSuKien"
                                       class="btn btn-sm btn-outline-secondary">Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@item.MaSuKien"
                                       class="btn btn-sm btn-outline-danger">Xóa</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Không có sự kiện nào khớp.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-3" aria-label="Phân trang">
            <ul class="pagination justify-content-center">
                <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-route-pageNumber="@(pageNumber - 1)" asp-route-search="@ViewBag.Search"
                       asp-route-trangThai="@ViewBag.TrangThai" asp-route-sortBy="@sortBy"
                       asp-route-sortDescending="@sortDescending" asp-route-maLoaiSuKien="@ViewBag.MaLoaiSuKien"
                       asp-route-maDiaDiem="@ViewBag.MaDiaDiem" asp-route-ngayBatDauTu="@ViewBag.NgayBatDauTu"
                       asp-route-ngayBatDauDen="@ViewBag.NgayBatDauDen"
                       asp-route-tinhTrangDangKy="@ViewBag.TinhTrangDangKy"
                       asp-route-soLuongTu="@ViewBag.SoLuongTu" asp-route-soLuongDen="@ViewBag.SoLuongDen"
                       asp-route-pageSize="@pageSize">Trước</a>
                </li>
                <li class="page-item active"><span class="page-link">Trang @pageNumber / @totalPages</span></li>
                <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-route-pageNumber="@(pageNumber + 1)" asp-route-search="@ViewBag.Search"
                       asp-route-trangThai="@ViewBag.TrangThai" asp-route-sortBy="@sortBy"
                       asp-route-sortDescending="@sortDescending" asp-route-maLoaiSuKien="@ViewBag.MaLoaiSuKien"
                       asp-route-maDiaDiem="@ViewBag.MaDiaDiem" asp-route-ngayBatDauTu="@ViewBag.NgayBatDauTu"
                       asp-route-ngayBatDauDen="@ViewBag.NgayBatDauDen"
                       asp-route-tinhTrangDangKy="@ViewBag.TinhTrangDangKy"
                       asp-route-soLuongTu="@ViewBag.SoLuongTu" asp-route-soLuongDen="@ViewBag.SoLuongDen"
                       asp-route-pageSize="@pageSize">Sau</a>
                </li>
            </ul>
        </nav>
    }
</div>
