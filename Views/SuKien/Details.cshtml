@model HTquanlyhoinghi_UNETI2_TI17A3HN.Models.SuKien

@{
    ViewData["Title"] = "Chi tiết sự kiện";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Chi tiết sự kiện</h1>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.MaSuKien" class="btn btn-primary">Sửa sự kiện</a>
            <a asp-action="Phien" asp-route-maSuKien="@Model.MaSuKien" class="btn btn-outline-info">Quản lý phiên</a>
        </div>
    </div>

    <dl class="row card card-body">
        <dt class="col-sm-3">Tên sự kiện</dt>
        <dd class="col-sm-9">@Model.TenSuKien</dd>
        <dt class="col-sm-3">Loại sự kiện</dt>
        <dd class="col-sm-9">@Model.LoaiSuKien?.TenLoaiSuKien</dd>
        <dt class="col-sm-3">Địa điểm</dt>
        <dd class="col-sm-9">@Model.DiaDiem?.TenDiaDiem</dd>
        <dt class="col-sm-3">Thời gian</dt>
        <dd class="col-sm-9">@Model.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm") - @Model.ThoiGianKetThuc.ToString("dd/MM/yyyy HH:mm")</dd>
        <dt class="col-sm-3">Trạng thái</dt>
        <dd class="col-sm-9">@Model.TrangThai</dd>
        <dt class="col-sm-3">Mô tả</dt>
        <dd class="col-sm-9">@Model.MoTa</dd>
    </dl>

    <h2 class="h4 mt-4">Các phiên sự kiện</h2>
    @if (Model.PhienSuKiens.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Tên phiên</th>
                        <th>Thời gian</th>
                        <th>Diễn giả</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var phien in Model.PhienSuKiens)
                    {
                        <tr>
                            <td>@phien.TenPhien</td>
                            <td>@phien.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm") - @phien.ThoiGianKetThuc.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@phien.DienGia</td>
                            <td>@phien.TrangThai</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted">Sự kiện chưa có phiên chương trình.</p>
    }
    <a asp-action="Index" class="btn btn-secondary mt-2">Quay lại</a>
</div>
