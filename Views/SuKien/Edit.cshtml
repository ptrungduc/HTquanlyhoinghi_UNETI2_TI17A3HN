@model HTquanlyhoinghi_UNETI2_TI17A3HN.Models.SuKien

@{
    ViewData["Title"] = "Chỉnh sửa sự kiện";
}

<div class="container mt-4">
    <h1>Chỉnh sửa sự kiện</h1>
    <form asp-action="Edit" asp-route-id="@Model.MaSuKien" method="post" class="card card-body">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="MaSuKien" class="form-label">Mã sự kiện</label>
            <input asp-for="MaSuKien" class="form-control" readonly />
        </div>
        <div class="mb-3">
            <label asp-for="TenSuKien" class="form-label">Tên sự kiện</label>
            <input asp-for="TenSuKien" class="form-control" />
            <span asp-validation-for="TenSuKien" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="MaLoaiSuKien" class="form-label">Loại sự kiện</label>
            <select asp-for="MaLoaiSuKien" asp-items="ViewBag.LoaiSuKien" class="form-select">
                <option value="">Chọn loại sự kiện</option>
            </select>
            <span asp-validation-for="MaLoaiSuKien" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="MaDiaDiem" class="form-label">Địa điểm</label>
            <select asp-for="MaDiaDiem" asp-items="ViewBag.DiaDiem" class="form-select">
                <option value="">Chọn địa điểm</option>
            </select>
            <span asp-validation-for="MaDiaDiem" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="ThoiGianBatDau" class="form-label">Thời gian bắt đầu</label>
                <input asp-for="ThoiGianBatDau" type="datetime-local" class="form-control" />
                <span asp-validation-for="ThoiGianBatDau" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="ThoiGianKetThuc" class="form-label">Thời gian kết thúc</label>
                <input asp-for="ThoiGianKetThuc" type="datetime-local" class="form-control" />
                <span asp-validation-for="ThoiGianKetThuc" class="text-danger"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="TrangThai" class="form-label">Trạng thái</label>
            <select asp-for="TrangThai" class="form-select">
                <option value="SapDienRa">Sắp diễn ra</option>
                <option value="DangDienRa">Đang diễn ra</option>
                <option value="DaKetThuc">Đã kết thúc</option>
                <option value="DaHuy">Đã hủy</option>
            </select>
        </div>
        <div class="mb-3">
            <label asp-for="MoTa" class="form-label">Mô tả</label>
            <textarea asp-for="MoTa" class="form-control" rows="4"></textarea>
            <span asp-validation-for="MoTa" class="text-danger"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
