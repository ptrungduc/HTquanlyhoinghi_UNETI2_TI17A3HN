@model HTquanlyhoinghi_UNETI2_TI17A3HN.Models.SuKien

@{
    ViewData["Title"] = "Thêm sự kiện";
}

<div class="container mt-4">
    <h1>Thêm sự kiện</h1>
    <form asp-action="Create" method="post" class="card card-body">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="MaSuKien" class="form-label">Mã sự kiện</label>
            <input asp-for="MaSuKien" class="form-control" readonly />
        </div>
        <div class="mb-3">
            <label asp-for="TenSuKien" class="form-label">Tên sự kiện</label>
            <input asp-for="TenSuKien" class="form-control" />
            <span asp-validation-for="TenSuKien" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="MaLoaiSuKien" class="form-label">Loại sự kiện</label>
            <select asp-for="MaLoaiSuKien" asp-items="ViewBag.LoaiSuKien" class="form-select">
                <option value="">Chọn loại sự kiện</option>
            </select>
            <span asp-validation-for="MaLoaiSuKien" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="MaDiaDiem" class="form-label">Địa điểm</label>
            <select asp-for="MaDiaDiem" asp-items="ViewBag.DiaDiem" class="form-select">
                <option value="">Chọn địa điểm</option>
            </select>
            <span asp-validation-for="MaDiaDiem" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="ThoiGianBatDau" class="form-label">Thời gian bắt đầu</label>
                <input asp-for="ThoiGianBatDau" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                <span asp-validation-for="ThoiGianBatDau" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="ThoiGianKetThuc" class="form-label">Thời gian kết thúc</label>
                <input asp-for="ThoiGianKetThuc" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                <span asp-validation-for="ThoiGianKetThuc" class="text-danger"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="HanDangKy" class="form-label">Hạn đăng ký</label>
                <input asp-for="HanDangKy" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                <span asp-validation-for="HanDangKy" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="SoLuongToiDa" class="form-label">Số lượng tối đa</label>
                <input asp-for="SoLuongToiDa" type="number" min="1" class="form-control" />
                <span asp-validation-for="SoLuongToiDa" class="text-danger"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="TrangThai" class="form-label">Trạng thái</label>
            <select asp-for="TrangThai" class="form-select">
                <option value="Nhap">Nháp</option>
                <option value="MoDangKy">Mở đăng ký</option>
                <option value="DongDangKy">Đóng đăng ký</option>
                <option value="DangDienRa">Đang diễn ra</option>
                <option value="HoanThanh">Hoàn thành</option>
                <option value="DaHuy">Đã hủy</option>
            </select>
            <span asp-validation-for="TrangThai" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="MoTa" class="form-label">Mô tả</label>
            <textarea asp-for="MoTa" class="form-control" rows="4"></textarea>
            <span asp-validation-for="MoTa" class="text-danger"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Lưu sự kiện</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
