@{
    ViewData["Title"] = "Đăng ký sự kiện";
    string maSuKien = ViewBag.MaSuKien?.ToString() ?? "";
}

<h2>Đăng ký sự kiện</h2>

@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger">
        @TempData["Loi"]
    </div>
}

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success">
        @TempData["ThongBao"]
    </div>
}

<form asp-action="DangKy" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden"
           name="maSuKien"
           value="@maSuKien" />

    <div class="mb-3">
        <label class="form-label" for="maNguoiThamDu">
            Mã người tham dự
        </label>

        <input type="number"
               id="maNguoiThamDu"
               name="maNguoiThamDu"
               class="form-control"
               min="1"
               required />

        <small class="text-muted">
            Nhập mã người tham dự đã được tạo trong hệ thống.
        </small>
    </div>

    <button type="submit" class="btn btn-primary">
        Đăng ký sự kiện
    </button>

    <a asp-controller="SuKien" asp-action="Index"
       class="btn btn-secondary">
        Quay lại
    </a>
</form>
