@model HTquanlyhoinghi_UNETI2_TI17A3HN.Models.Module3.DangKyModule3ViewModel

@{
    ViewData["Title"] = "Đăng ký sự kiện";
}

<h2>Người tham dự và đăng ký sự kiện</h2>

@if (TempData["ThongBao"] is string thongBao)
{
    <div class="alert alert-success">@thongBao</div>
}
@if (TempData["Loi"] is string loi)
{
    <div class="alert alert-danger">@loi</div>
}
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(Model.Tab == "su-kien" ? "active" : "")"
           asp-action="Index"
           asp-route-tab="su-kien">Sự kiện mở đăng ký</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.Tab == "ca-nhan" ? "active" : "")"
           asp-action="Index"
           asp-route-tab="ca-nhan">Đăng ký của tôi</a>
    </li>
    @if (Model.LaQuanTri)
    {
        <li class="nav-item">
            <a class="nav-link @(Model.Tab == "tim-kiem" ? "active" : "")"
               asp-action="Index"
               asp-route-tab="tim-kiem">Tìm kiếm đăng ký</a>
        </li>
    }
</ul>

@if (Model.Tab == "su-kien")
{
    <h3>Sự kiện đang mở đăng ký</h3>
    <form method="get" asp-action="Index" class="row g-2 mb-3">
        <input type="hidden" name="tab" value="su-kien" />
        <div class="col-md-5">
            <input type="text" name="tuKhoaSuKien" value="@Model.TuKhoaSuKien"
                   class="form-control" placeholder="Tìm tên sự kiện" aria-label="Tìm tên sự kiện" />
        </div>
        <div class="col-md-4">
            <select name="maLoaiSuKienSuKien" class="form-select" aria-label="Lọc theo loại sự kiện">
                <option value="">Tất cả loại sự kiện</option>
                @foreach (var category in Model.LoaiSuKiens)
                {
                    <option value="@category.MaLoaiSuKien" selected="@(Model.MaLoaiSuKienSuKien == category.MaLoaiSuKien)">
                        @category.TenLoaiSuKien
                    </option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Tìm sự kiện</button>
            <a asp-action="Index" asp-route-tab="su-kien" class="btn btn-outline-secondary">Xóa lọc</a>
        </div>
    </form>

    @if (Model.SuKiens.Count == 0)
    {
        <div class="alert alert-info">Hiện không có sự kiện phù hợp đang mở đăng ký hoặc còn chỗ.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead>
                    <tr><th>Mã sự kiện</th><th>Sự kiện</th><th>Loại</th><th>Địa điểm</th><th>Bắt đầu</th><th>Sức chứa</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var item in Model.SuKiens)
                {
                    <tr>
                        <td>@item.MaSuKien</td>
                        <td>@item.TenSuKien</td>
                        <td>@item.TenLoaiSuKien</td>
                        <td>@item.TenDiaDiem</td>
                        <td>@item.BatDau.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.SoLuongHieuLuc / @item.SucChua chỗ đã được giữ</td>
                        <td>
                            <a asp-action="DangKy" asp-route-maSuKien="@item.MaSuKien"
                               class="btn btn-sm btn-primary">Xem / đăng ký</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}
else if (Model.Tab == "ca-nhan")
{
    <h3>Đăng ký của tôi</h3>
    @if (!Model.CoHoSoNguoiThamDu)
    {
        <div class="alert alert-warning">
            Tài khoản chưa có hồ sơ người tham dự.
            <a asp-controller="NguoiThamDu" asp-action="HoSo">Hoàn thiện hồ sơ</a> để đăng ký sự kiện.
        </div>
    }
    else
    {
        <form method="get" asp-action="Index" class="row g-2 mb-3">
            <input type="hidden" name="tab" value="ca-nhan" />
            <div class="col-md-2">
                <select name="trangThai" class="form-select" aria-label="Lọc theo trạng thái">
                    <option value="">Tất cả trạng thái</option>
                    @foreach (var status in Enum.GetValues<HTquanlyhoinghi_UNETI2_TI17A3HN.Models.TrangThaiDangKy>())
                    {
                        <option value="@status" selected="@(Model.TrangThai == status.ToString())">
                            @HTquanlyhoinghi_UNETI2_TI17A3HN.Models.Module3.DangKyDongViewModel.TenTrangThai(status)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="maLoaiSuKien" class="form-select" aria-label="Lọc theo loại sự kiện">
                    <option value="">Tất cả loại sự kiện</option>
                    @foreach (var category in Model.LoaiSuKiens)
                    {
                        <option value="@category.MaLoaiSuKien" selected="@(Model.MaLoaiSuKien == category.MaLoaiSuKien)">
                            @category.TenLoaiSuKien
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="tuNgay" value="@Model.TuNgay?.ToString("yyyy-MM-dd")"
                       class="form-control" aria-label="Từ ngày đăng ký" />
            </div>
            <div class="col-md-2">
                <input type="date" name="denNgay" value="@Model.DenNgay?.ToString("yyyy-MM-dd")"
                       class="form-control" aria-label="Đến ngày đăng ký" />
            </div>
            <div class="col-md-2">
                <select name="sapXep" class="form-select" aria-label="Sắp xếp đăng ký">
                    <option value="ngaydangky" selected="@(Model.SapXep == "ngaydangky")">Ngày đăng ký</option>
                    <option value="ngaytochuc" selected="@(Model.SapXep == "ngaytochuc")">Ngày tổ chức</option>
                </select>
            </div>
            <div class="col-md-2"><button type="submit" class="btn btn-primary">Lọc đăng ký</button></div>
        </form>

        @if (Model.DangKysCuaToi.Count == 0)
        {
            <div class="alert alert-info">
                Không tìm thấy đăng ký nào phù hợp.
                <a asp-action="Index" asp-route-tab="su-kien">Tìm sự kiện đang mở đăng ký</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle">
                    <thead>
                        <tr><th>Mã đăng ký</th><th>Mã sự kiện</th><th>Sự kiện</th><th>Ngày đăng ký</th><th>Ngày tổ chức</th><th>Trạng thái</th><th>Hạn hủy</th><th>Thao tác</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.DangKysCuaToi)
                    {
                        <tr>
                            <td>@item.MaDangKy</td>
                            <td>@item.MaSuKien</td>
                            <td>@item.TenSuKien</td>
                            <td>@item.NgayDangKy.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@item.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@item.TrangThaiHienThi</td>
                            <td>@(item.HanHuy == DateTime.MinValue ? "-" : item.HanHuy.ToString("dd/MM/yyyy HH:mm"))</td>
                            <td>
                                @if (item.TrangThai is HTquanlyhoinghi_UNETI2_TI17A3HN.Models.TrangThaiDangKy.ChoDuyet or HTquanlyhoinghi_UNETI2_TI17A3HN.Models.TrangThaiDangKy.DaDuyet)
                                {
                                    @if (DateTime.Now < item.HanHuy)
                                    {
                                        <form asp-action="Huy" method="post" class="d-flex gap-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="maDangKy" value="@item.MaDangKy" />
                                            <input type="text" name="lyDoHuy" placeholder="Lý do hủy (không bắt buộc)"
                                                   aria-label="Lý do hủy đăng ký @item.TenSuKien" class="form-control" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Hủy</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Đã quá hạn hủy</span>
                                    }
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    }
}
else if (Model.Tab == "tim-kiem" && Model.LaQuanTri)
{
    <h3>Tìm kiếm đăng ký</h3>
    <form method="get" asp-action="Index" class="row g-2 mb-3">
        <input type="hidden" name="tab" value="tim-kiem" />
        <div class="col-md-2">
            <input type="text" name="tenNguoiThamDu" value="@Model.TenNguoiThamDu"
                   class="form-control" placeholder="Tên người tham dự" aria-label="Tên người tham dự" />
        </div>
        <div class="col-md-2">
            <input type="text" name="maSuKien" value="@Model.MaSuKien"
                   class="form-control" placeholder="Mã sự kiện" aria-label="Mã sự kiện" />
        </div>
        <div class="col-md-2">
            <select name="trangThai" class="form-select" aria-label="Lọc theo trạng thái">
                <option value="">Tất cả trạng thái</option>
                @foreach (var status in Enum.GetValues<HTquanlyhoinghi_UNETI2_TI17A3HN.Models.TrangThaiDangKy>())
                {
                    <option value="@status" selected="@(Model.TrangThai == status.ToString())">
                        @HTquanlyhoinghi_UNETI2_TI17A3HN.Models.Module3.DangKyDongViewModel.TenTrangThai(status)
                    </option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="maLoaiSuKien" class="form-select" aria-label="Lọc theo loại sự kiện">
                <option value="">Tất cả loại sự kiện</option>
                @foreach (var category in Model.LoaiSuKiens)
                {
                    <option value="@category.MaLoaiSuKien" selected="@(Model.MaLoaiSuKien == category.MaLoaiSuKien)">
                        @category.TenLoaiSuKien
                    </option>
                }
            </select>
        </div>
        <div class="col-md-1">
            <input type="date" name="tuNgay" value="@Model.TuNgay?.ToString("yyyy-MM-dd")"
                   class="form-control" aria-label="Từ ngày đăng ký" />
        </div>
        <div class="col-md-1">
            <input type="date" name="denNgay" value="@Model.DenNgay?.ToString("yyyy-MM-dd")"
                   class="form-control" aria-label="Đến ngày đăng ký" />
        </div>
        <div class="col-md-1">
            <select name="sapXep" class="form-select" aria-label="Sắp xếp đăng ký">
                <option value="ngaydangky" selected="@(Model.SapXep == "ngaydangky")">Ngày đăng ký</option>
                <option value="ngaytochuc" selected="@(Model.SapXep == "ngaytochuc")">Ngày tổ chức</option>
            </select>
        </div>
        <div class="col-md-1"><button type="submit" class="btn btn-primary">Tìm</button></div>
    </form>

    @if (Model.KetQuaTimKiem.Count == 0)
    {
        <div class="alert alert-info">Không tìm thấy đăng ký nào phù hợp với điều kiện tìm kiếm.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead>
                    <tr><th>Mã đăng ký</th><th>Mã sự kiện</th><th>Người tham dự</th><th>Sự kiện</th><th>Ngày đăng ký</th><th>Ngày tổ chức</th><th>Trạng thái</th><th>Hạn hủy</th></tr>
                </thead>
                <tbody>
                @foreach (var item in Model.KetQuaTimKiem)
                {
                    <tr>
                        <td>@item.MaDangKy</td>
                        <td>@item.MaSuKien</td>
                        <td>@item.TenNguoiThamDu</td>
                        <td>@item.TenSuKien</td>
                        <td>@item.NgayDangKy.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.TrangThaiHienThi</td>
                        <td>@(item.HanHuy == DateTime.MinValue ? "-" : item.HanHuy.ToString("dd/MM/yyyy HH:mm"))</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}
