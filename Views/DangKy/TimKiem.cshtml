@model HTquanlyhoinghi_UNETI2_TI17A3HN.Models.Module3.DangKyTimKiemViewModel

@{
    ViewData["Title"] = "Tìm kiếm đăng ký";
}

<h2>Tìm kiếm đăng ký</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-2"><input type="text" name="tenNguoiThamDu" value="@Model.TenNguoiThamDu" class="form-control" placeholder="Tên người tham dự" /></div>
    <div class="col-md-2"><input type="text" name="maSuKien" value="@Model.MaSuKien" class="form-control" placeholder="Mã sự kiện" /></div>
    <div class="col-md-2">
        <select name="trangThai" class="form-select">
            <option value="">Tất cả trạng thái</option>
            @foreach (var status in Enum.GetValues<HTquanlyhoinghi_UNETI2_TI17A3HN.Models.TrangThaiDangKy>())
            {
                <option value="@status" selected="@(Model.TrangThai == status.ToString())">@status</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="maLoaiSuKien" class="form-select">
            <option value="">Tất cả loại sự kiện</option>
            @foreach (var category in Model.LoaiSuKiens)
            {
                <option value="@category.MaLoaiSuKien" selected="@(Model.MaLoaiSuKien == category.MaLoaiSuKien)">@category.TenLoaiSuKien</option>
            }
        </select>
    </div>
    <div class="col-md-1"><input type="date" name="tuNgay" value="@Model.TuNgay?.ToString("yyyy-MM-dd")" class="form-control" aria-label="Từ ngày đăng ký" /></div>
    <div class="col-md-1"><input type="date" name="denNgay" value="@Model.DenNgay?.ToString("yyyy-MM-dd")" class="form-control" aria-label="Đến ngày đăng ký" /></div>
    <div class="col-md-1">
        <select name="sapXep" class="form-select">
            <option value="ngaydangky" selected="@(Model.SapXep == "ngaydangky")">Ngày đăng ký</option>
            <option value="ngaytochuc" selected="@(Model.SapXep == "ngaytochuc")">Ngày tổ chức</option>
        </select>
    </div>
    <div class="col-md-1"><button type="submit" class="btn btn-primary">Tìm</button></div>
</form>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
@if (Model.DangKys.Count == 0)
{
    <div class="alert alert-info">Không tìm thấy đăng ký nào phù hợp với các điều kiện tìm kiếm.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead>
                <tr><th>Người tham dự</th><th>Sự kiện</th><th>Ngày đăng ký</th><th>Ngày tổ chức</th><th>Trạng thái</th><th>Hạn hủy</th></tr>
            </thead>
            <tbody>
            @foreach (var item in Model.DangKys)
            {
                <tr>
                    <td>@item.TenNguoiThamDu</td>
                    <td>@item.TenSuKien</td>
                    <td>@item.NgayDangKy.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.TrangThaiHienThi</td>
                    <td>@(item.HanHuy == DateTime.MinValue ? "-" : item.HanHuy.ToString("dd/MM/yyyy HH:mm"))</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
