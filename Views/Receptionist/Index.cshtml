@model HTquanlyhoinghi_UNETI2_TI17A3HN.Models.ReceptionistDashboardViewModel
@{
    ViewData["Title"] = "Bàn tiếp đón - Lễ tân";
    var hoTenLeTan = Context.Session.GetString("HoTen") ?? "Lễ tân";
}

<!-- Header -->
<header class="admin-header d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">🛎️ Bàn tiếp đón</h2>
        <p class="text-muted mb-0">Hệ thống điều phối, tra cứu và check-in đại biểu</p>
    </div>
    <div class="d-flex gap-2 mt-2 mt-md-0">
        <a class="btn btn-outline-primary" asp-action="Index">
            🔄 Làm mới
        </a>
        <a class="btn btn-primary" asp-controller="CheckIn" asp-action="Index">
            🎟️ Check-in tham dự
        </a>
        <a class="btn btn-outline-secondary" asp-controller="DiemDanhPhien" asp-action="Index">
            📋 Điểm danh phiên
        </a>
    </div>
</header>

<!-- Thông báo kết quả thao tác -->
@if (Model.KetQua != null)
{
    <div class="alert @(Model.KetQua.ThanhCong ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
        <strong>@(Model.KetQua.ThanhCong ? "Thành công!" : "Thông báo:")</strong> @Model.KetQua.ThongBao
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Hộp chào mừng Lễ tân -->
<section class="welcome-box mb-4">
    <div>
        <h1>Xin chào, @hoTenLeTan! 👋</h1>
        <p>
            Chào mừng bạn đến với ca trực bàn tiếp đón. Hôm nay có <strong>@Model.TongSuKienHomNay</strong> sự kiện đang diễn ra, 
            đã tiếp đón thành công <strong>@Model.TongDaCheckInHomNay</strong> đại biểu.
        </p>
    </div>
    <div class="welcome-icon">
        🛎️
    </div>
</section>

<!-- Thống kê nhanh trong ngày -->
<section class="stat-grid mb-4">
    <div class="stat-card">
        <div class="stat-icon blue">
            📅
        </div>
        <div>
            <span>Sự kiện hôm nay</span>
            <strong>@Model.TongSuKienHomNay</strong>
            <small>sự kiện đang diễn ra</small>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon green">
            ✅
        </div>
        <div>
            <span>Đã Check-in hôm nay</span>
            <strong>@Model.TongDaCheckInHomNay</strong>
            <small>lượt đại biểu có mặt</small>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon orange">
            ⏳
        </div>
        <div>
            <span>Chờ tiếp đón</span>
            <strong>@Model.TongChoCheckInHomNay</strong>
            <small>đã duyệt chưa check-in</small>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon purple">
            👥
        </div>
        <div>
            <span>Tổng lượt đăng ký</span>
            <strong>@Model.TongDangKyHomNay</strong>
            <small>hợp lệ cho hôm nay</small>
        </div>
    </div>
</section>

<!-- Khu vực Check-in nhanh bằng mã -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-header bg-primary text-white py-3 d-flex align-items-center justify-content-between">
        <h5 class="mb-0 fs-6 fw-bold">⚡ Check-in nhanh bằng mã tham dự</h5>
        <span class="badge bg-light text-primary">Quét mã / Nhập mã</span>
    </div>
    <div class="card-body p-4">
        <form asp-action="CheckInNhanh" method="post" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="tuKhoa" value="@Model.TuKhoa" />
            <input type="hidden" name="maSuKien" value="@Model.MaSuKienChon" />

            <div class="col-md-5">
                <label for="maThamDuInput" class="form-label fw-semibold">Mã tham dự <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-light">🎟️</span>
                    <input type="text" id="maThamDuInput" name="maThamDu" class="form-control form-control-lg"
                           placeholder="Nhập hoặc quét mã (VD: TD-0015, TD-0016...)" required autofocus autocomplete="off" />
                </div>
            </div>
            <div class="col-md-5">
                <label for="ghiChuInput" class="form-label fw-semibold">Ghi chú tiếp đón</label>
                <input type="text" id="ghiChuInput" name="ghiChu" class="form-control form-control-lg"
                       placeholder="Ghi chú thêm (VD: Nhận thẻ đại biểu, quà tặng...)" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-success btn-lg w-100 fw-bold">
                    ✓ Check-in
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Danh sách sự kiện hôm nay / đang diễn ra -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fs-6 fw-bold text-dark">
            📅 Sự kiện hôm nay / Sắp diễn ra (@Model.DanhSachSuKien.Count)
        </h5>
        <span class="text-muted small">Thời gian diễn ra &amp; Tiến độ tiếp đón</span>
    </div>
    <div class="card-body p-3">
        @if (Model.DanhSachSuKien.Count == 0)
        {
            <div class="text-center py-4 text-muted">
                <p class="mb-0">Hiện không có sự kiện nào diễn ra hôm nay hoặc sắp tới.</p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var sk in Model.DanhSachSuKien)
                {
                    var phanTram = sk.TongDangKy > 0 ? (int)Math.Round((double)sk.DaCheckIn / sk.TongDangKy * 100) : 0;
                    <div class="col-lg-6">
                        <div class="border rounded p-3 h-100 position-relative @(sk.DangDienRa ? "border-primary bg-primary bg-opacity-10" : "")">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="badge @(sk.DangDienRa ? "bg-success" : "bg-secondary") mb-1">
                                        @(sk.DangDienRa ? "🟢 Đang diễn ra" : sk.TrangThai)
                                    </span>
                                    <span class="badge bg-info text-dark">@sk.TenLoaiSuKien</span>
                                    <h6 class="fw-bold mb-1 mt-1 text-primary">@sk.TenSuKien</h6>
                                </div>
                            </div>

                            <div class="small text-muted mb-2">
                                <div>📍 <strong>Địa điểm:</strong> @sk.TenDiaDiem</div>
                                <div>⏰ <strong>Thời gian:</strong> @sk.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm") - @sk.ThoiGianKetThuc.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>

                            <!-- Tiến độ check-in -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span>Tiến độ tiếp đón: <strong>@sk.DaCheckIn/@sk.TongDangKy</strong> đại biểu</span>
                                    <span class="fw-bold text-primary">@phanTram%</span>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: @phanTram%" aria-valuenow="@phanTram" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>

                            <!-- Thao tác nhanh -->
                            <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-route-maSuKien="@sk.MaSuKien">
                                    🔍 Lọc đại biểu sự kiện này
                                </a>
                                <a class="btn btn-sm btn-primary" asp-controller="CheckIn" asp-action="Index">
                                    🎟️ Màn hình Check-in
                                </a>
                                @if (sk.DanhSachPhien.Any())
                                {
                                    <div class="dropdown d-inline">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                            📋 Điểm danh phiên (@sk.DanhSachPhien.Count)
                                        </button>
                                        <ul class="dropdown-menu">
                                            @foreach (var phien in sk.DanhSachPhien)
                                            {
                                                <li>
                                                    <a class="dropdown-item" asp-controller="DiemDanhPhien" asp-action="Index" asp-route-maPhienSuKien="@phien.MaPhienSuKien">
                                                        @phien.TenPhien (@phien.PhongKhuVuc)
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Khu vực Tra cứu & Tiếp đón đại biểu -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h5 class="mb-0 fs-6 fw-bold text-dark">👥 Tra cứu &amp; Tiếp đón đại biểu</h5>
                <span class="text-muted small">Tìm kiếm người tham dự theo tên, số điện thoại, email hoặc mã tham dự</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.TuKhoa) || !string.IsNullOrEmpty(Model.MaSuKienChon))
            {
                <a class="btn btn-sm btn-outline-danger" asp-action="Index">
                    ✖ Xóa bộ lọc
                </a>
            }
        </div>

        <!-- Form tìm kiếm & bộ lọc -->
        <form asp-action="Index" method="get" class="row g-2 mt-2">
            <div class="col-md-6">
                <input type="text" name="tuKhoa" value="@Model.TuKhoa" class="form-control"
                       placeholder="Nhập tên, số điện thoại, email hoặc mã tham dự..." />
            </div>
            <div class="col-md-4">
                <select name="maSuKien" class="form-select">
                    <option value="">-- Tất cả sự kiện --</option>
                    @foreach (var sk in Model.DanhSachSuKien)
                    {
                        <option value="@sk.MaSuKien" selected="@(sk.MaSuKien == Model.MaSuKienChon)">
                            @sk.TenSuKien
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary">
                    🔍 Tìm kiếm
                </button>
            </div>
        </form>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 140px;">Mã tham dự</th>
                        <th>Họ tên &amp; Đơn vị</th>
                        <th>Liên hệ</th>
                        <th>Sự kiện</th>
                        <th style="width: 150px;">Trạng thái</th>
                        <th style="width: 160px;" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DanhSachNguoiThamDu.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <div>🔍 Không tìm thấy đại biểu nào phù hợp.</div>
                                <small>Thử tìm kiếm với từ khóa khác hoặc xóa bộ lọc sự kiện.</small>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ntd in Model.DanhSachNguoiThamDu)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(ntd.MaThamDu) && ntd.MaThamDu != "-")
                                    {
                                        <span class="badge bg-dark font-monospace fs-6 px-2 py-1">@ntd.MaThamDu</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Chưa cấp</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@ntd.HoTen</div>
                                    @if (!string.IsNullOrWhiteSpace(ntd.DonViCongTac))
                                    {
                                        <small class="text-muted">🏢 @ntd.DonViCongTac</small>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(ntd.SoDienThoai))
                                    {
                                        <div><small>📞 @ntd.SoDienThoai</small></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(ntd.Email))
                                    {
                                        <div><small class="text-muted">✉️ @ntd.Email</small></div>
                                    }
                                </td>
                                <td>
                                    <span class="fw-semibold text-primary">@ntd.TenSuKien</span>
                                </td>
                                <td>
                                    @if (ntd.TrangThaiDangKy == HTquanlyhoinghi_UNETI2_TI17A3HN.Models.TrangThaiDangKy.DaCheckIn)
                                    {
                                        <span class="badge bg-success">
                                            ✓ Đã Check-in
                                        </span>
                                        @if (ntd.ThoiGianCheckIn.HasValue)
                                        {
                                            <div class="text-muted small mt-1">@ntd.ThoiGianCheckIn.Value.ToString("HH:mm dd/MM")</div>
                                        }
                                    }
                                    else if (ntd.TrangThaiDangKy == HTquanlyhoinghi_UNETI2_TI17A3HN.Models.TrangThaiDangKy.DaDuyet)
                                    {
                                        <span class="badge bg-primary">
                                            Đã duyệt - Chờ vào
                                        </span>
                                    }
                                    else if (ntd.TrangThaiDangKy == HTquanlyhoinghi_UNETI2_TI17A3HN.Models.TrangThaiDangKy.ChoDuyet)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Chờ duyệt
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @ntd.TrangThaiDangKy.ToString()
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (ntd.CoTheCheckIn)
                                    {
                                        <form asp-action="CheckInNhanh" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="maThamDu" value="@ntd.MaThamDu" />
                                            <input type="hidden" name="ghiChu" value="Check-in nhanh từ danh sách tiếp đón" />
                                            <input type="hidden" name="tuKhoa" value="@Model.TuKhoa" />
                                            <input type="hidden" name="maSuKien" value="@Model.MaSuKienChon" />
                                            <button type="submit" class="btn btn-sm btn-success fw-semibold">
                                                ⚡ Check-in
                                            </button>
                                        </form>
                                    }
                                    else if (ntd.TrangThaiDangKy == HTquanlyhoinghi_UNETI2_TI17A3HN.Models.TrangThaiDangKy.DaCheckIn)
                                    {
                                        <button class="btn btn-sm btn-outline-success disabled" disabled>
                                            ✓ Hoàn tất
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-light border text-muted" disabled title="Chỉ có thể check-in khi đăng ký đã duyệt và sự kiện đang diễn ra">
                                            Chưa thể check-in
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Tự động focus vào ô nhập mã khi tải trang
        document.addEventListener("DOMContentLoaded", function () {
            var inputMa = document.getElementById("maThamDuInput");
            if (inputMa) {
                inputMa.focus();
            }
        });
    </script>
}
