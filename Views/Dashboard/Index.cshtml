@* Họ và tên: [TÊN CỦA TÔI] *@
@* Mã sinh viên: [MSSV CỦA TÔI] *@
@* Nội dung thực hiện: Module 5 - Dashboard Organizer/Admin (Bước 2). *@

@model HTquanlyhoinghi_UNETI2_TI17A3HN.Models.Module5.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    var tongDangKy = Model.DangKyTheoTrangThai.Sum(x => x.SoLuong);
    var maxNguoi = Model.NguoiThamDuTheoThang.Count == 0
        ? 1
        : Math.Max(1, Model.NguoiThamDuTheoThang.Max(x => x.SoNguoi));
}

<header class="admin-header">
    <div>
        <h2>📊 Dashboard</h2>
        <p>Số liệu tính từ cơ sở dữ liệu lúc @Model.ThoiDiemTinh.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
</header>

<div class="container mt-4">

    <!-- 1. TỔNG SỐ SỰ KIỆN + CHECK-IN HÔM NAY -->
    <div class="row mb-4">
        <div class="col-md-6 mb-3">
            <div class="card border-0 shadow-sm text-center h-100">
                <div class="card-body">
                    <h2 class="text-primary fw-bold">@Model.TongSuKien</h2>
                    <small class="text-muted">Tổng số sự kiện</small>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="card border-0 shadow-sm text-center h-100">
                <div class="card-body">
                    <h2 class="text-info fw-bold">@Model.CheckInHomNay</h2>
                    <small class="text-muted">Lượt check-in hôm nay</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <!-- 2. SỰ KIỆN THEO TRẠNG THÁI -->
        <div class="col-md-6 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><h6 class="mb-0">📅 Sự kiện theo trạng thái</h6></div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <tbody>
                            @foreach (var item in Model.SuKienTheoTrangThai)
                            {
                                <tr>
                                    <td><span class="badge @item.CssClass">@item.TenHienThi</span></td>
                                    <td class="text-end fw-bold">@item.SoLuong</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 3. ĐĂNG KÝ THEO TRẠNG THÁI -->
        <div class="col-md-6 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><h6 class="mb-0">📋 Đăng ký theo trạng thái (tổng: @tongDangKy)</h6></div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <tbody>
                            @foreach (var item in Model.DangKyTheoTrangThai)
                            {
                                <tr>
                                    <td><span class="badge @item.CssClass">@item.TenHienThi</span></td>
                                    <td class="text-end fw-bold">@item.SoLuong</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <!-- 5. SỰ KIỆN SẮP DIỄN RA -->
        <div class="col-md-6 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><h6 class="mb-0">⏭️ Sự kiện sắp diễn ra</h6></div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Sự kiện</th>
                                    <th>Bắt đầu</th>
                                    <th>Địa điểm</th>
                                    <th class="text-end">Đăng ký / Sức chứa</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.SuKienSapDienRa)
                                {
                                    <tr>
                                        <td><strong>@s.TenSuKien</strong></td>
                                        <td>@s.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@s.TenDiaDiem</td>
                                        <td class="text-end">@s.SoDangKyHieuLuc / @s.SucChua</td>
                                    </tr>
                                }
                                @if (!Model.SuKienSapDienRa.Any())
                                {
                                    <tr><td colspan="4" class="text-center text-muted py-3">Không có sự kiện sắp diễn ra.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 7. SỰ KIỆN GẦN HẠN ĐĂNG KÝ -->
        <div class="col-md-6 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white">
                    <h6 class="mb-0">⏰ Sự kiện gần hạn đăng ký</h6>
                    <small class="text-muted">Đang mở đăng ký, bắt đầu trong 7 ngày tới</small>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Sự kiện</th>
                                    <th>Bắt đầu</th>
                                    <th>Địa điểm</th>
                                    <th class="text-end">Đăng ký / Sức chứa</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.SuKienGanHanDangKy)
                                {
                                    <tr>
                                        <td><strong>@s.TenSuKien</strong></td>
                                        <td>@s.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@s.TenDiaDiem</td>
                                        <td class="text-end">@s.SoDangKyHieuLuc / @s.SucChua</td>
                                    </tr>
                                }
                                @if (!Model.SuKienGanHanDangKy.Any())
                                {
                                    <tr><td colspan="4" class="text-center text-muted py-3">Không có sự kiện gần hạn đăng ký.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 6. NGƯỜI THAM DỰ THỰC TẾ THEO THÁNG -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white">
            <h6 class="mb-0">📈 Người tham dự thực tế theo tháng (12 tháng gần nhất, theo check-in)</h6>
        </div>
        <div class="card-body">
            <div class="d-flex align-items-end justify-content-between gap-1" style="height: 180px;">
                @foreach (var t in Model.NguoiThamDuTheoThang)
                {
                    var h = (int)Math.Round((double)t.SoNguoi / maxNguoi * 130);
                    <div class="text-center flex-fill">
                        <small class="d-block fw-bold">@t.SoNguoi</small>
                        <div style="height:@(h)px;background:#0dcaf0;border-radius:4px 4px 0 0;min-height:2px;"></div>
                        <small class="d-block text-muted" style="font-size:0.65rem;">@t.NhanThang</small>
                    </div>
                }
            </div>
        </div>
    </div>

</div>
