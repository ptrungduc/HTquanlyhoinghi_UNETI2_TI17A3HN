@model IEnumerable<HTquanlyhoinghi_UNETI2_TI17A3HN.Models.DiaDiem>

@{
    ViewData["Title"] = "Địa điểm";

    var tuKhoa = ViewBag.TuKhoa as string ?? "";
    int page = ViewBag.Page ?? 1;
    int tongSoTrang = ViewBag.TongSoTrang ?? 1;
}

<!-- Header -->
<header class="admin-header">

    <div>
        <h2>Địa điểm</h2>
        <p>Quản lý và cập nhật danh sách các địa điểm tổ chức sự kiện</p>
    </div>

    <div class="admin-account">

        <div class="admin-avatar">
            A
        </div>

        <div>
            <strong>Admin</strong>
            <small>Quản trị viên</small>
        </div>

    </div>

</header>


<div class="dia-diem-container">

    <!-- Thanh tìm kiếm -->
    <div class="toolbar">

        <form asp-controller="DiaDiem" asp-action="Index" method="get" class="search-form">

            <div class="search-box">

                <input type="text" name="tuKhoa" value="@tuKhoa" placeholder="Tìm kiếm địa điểm..." />

                <button type="submit" class="search-button">
                    🔍
                </button>

            </div>

        </form>


        <!-- Thêm địa điểm -->
        <a asp-controller="DiaDiem" asp-action="Create" class="btn-add">

            <span>＋</span>
            Thêm Địa điểm

        </a>

    </div>


    <!-- Bảng địa điểm -->
    <div class="table-wrapper">

        <table class="dia-diem-table">

            <thead>
                <tr>

                    <th>Tên Địa điểm</th>

                    <th>Địa chỉ</th>

                    <th>Sức chứa</th>

                    <th>Trạng thái</th>

                    <th>Hành động</th>

                </tr>
            </thead>


            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <!-- Tên -->
                            <td>
                                <strong>
                                    @item.TenDiaDiem
                                </strong>
                            </td>


                            <!-- Địa chỉ -->
                            <td>
                                @item.DiaChi
                            </td>


                            <!-- Sức chứa -->
                            <td>
                                @item.SucChuaToiDa
                            </td>


                            <!-- Trạng thái -->
                            <td>

                                @if (item.TrangThai)
                                {
                                    <span class="status active">

                                        <span class="status-dot"></span>

                                        Hoạt động

                                    </span>
                                }
                                else
                                {
                                    <span class="status inactive">

                                        <span class="status-dot"></span>

                                        Ngừng hoạt động

                                    </span>
                                }

                            </td>


                            <!-- Hành động -->
                            <td>

                                <div class="action-buttons">

                                    <!-- Sửa -->
                                    <a asp-controller="DiaDiem" asp-action="Edit" asp-route-id="@item.MaDiaDiem"
                                       class="btn-edit" title="Sửa">

                                        ✎

                                    </a>


                                    @if (item.TrangThai)
                                    {
                                        <!-- Ngừng hoạt động -->
                                        <form asp-controller="DiaDiem" asp-action="NgungHoatDong" asp-route-id="@item.MaDiaDiem"
                                              method="post" class="action-form">

                                            @Html.AntiForgeryToken()

                                            <button type="submit" class="btn-delete" title="Ngừng hoạt động"
                                                    onclick="return confirm('Bạn có chắc muốn ngừng hoạt động địa điểm này không?');">

                                                🗑

                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <!-- Kích hoạt -->
                                        <form asp-controller="DiaDiem" asp-action="KichHoat" asp-route-id="@item.MaDiaDiem"
                                              method="post" class="action-form">

                                            @Html.AntiForgeryToken()

                                            <button type="submit" class="btn-active" title="Kích hoạt">

                                                ✓

                                            </button>

                                        </form>
                                    }

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="5" class="empty-data">

                            Không tìm thấy địa điểm nào.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>


    <!-- Phân trang -->
    @if (tongSoTrang > 0)
    {
        <div class="pagination-container">

            <span class="page-info">
                Trang @($"{page}/{tongSoTrang}")
            </span>


            <div class="pagination-buttons">

                @if (page > 1)
                {
                    <a asp-controller="DiaDiem" asp-action="Index" asp-route-page="@(page - 1)" asp-route-tuKhoa="@tuKhoa"
                       class="page-button">

                        ‹

                    </a>
                }
                else
                {
                    <span class="page-button disabled">
                        ‹
                    </span>
                }


                @if (page < tongSoTrang)
                {
                    <a asp-controller="DiaDiem" asp-action="Index" asp-route-page="@(page + 1)" asp-route-tuKhoa="@tuKhoa"
                       class="page-button">

                        ›

                    </a>
                }
                else
                {
                    <span class="page-button disabled">
                        ›
                    </span>
                }

            </div>

        </div>
    }

</div>