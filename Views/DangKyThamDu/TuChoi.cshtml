@* Họ và tên: [TÊN CỦA TÔI] *@
@* Mã sinh viên: [MSSV CỦA TÔI] *@
@* Nội dung thực hiện: Module 4 - Xét duyệt đăng ký, mã tham dự, check-in, điểm danh. *@
@model HTquanlyhoinghi_UNETI2_TI17A3HN.Models.Module4.TuChoiDangKyViewModel

@{
    ViewData["Title"] = "Từ chối đăng ký";
    var ketQua = ViewBag.KetQuaThaoTac as HTquanlyhoinghi_UNETI2_TI17A3HN.Models.Module4.KetQuaThaoTacViewModel;
}

<h1 class="h3 mb-4">Từ chối đăng ký</h1>

@if (ketQua is not null)
{
    <div class="alert @(ketQua.ThanhCong ? "alert-success" : "alert-danger")" role="status">@ketQua.ThongBao</div>
}

<div class="alert alert-info" role="status">Chỉ đăng ký đang chờ duyệt mới được từ chối.</div>

<form asp-action="TuChoi" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <span>Mã đăng ký: <code>@Model.MaDangKy</code></span>
        <input asp-for="MaDangKy" type="hidden" />
    </div>
    <div class="mb-3">
        <label asp-for="LyDoTuChoi" class="form-label"></label>
        <textarea asp-for="LyDoTuChoi" class="form-control" rows="4"></textarea>
        <span asp-validation-for="LyDoTuChoi" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-danger">Gửi từ chối</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
</form>