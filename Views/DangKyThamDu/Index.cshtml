@* Họ và tên: [TÊN CỦA TÔI] *@
@* Mã sinh viên: [MSSV CỦA TÔI] *@
@* Nội dung thực hiện: Module 4 - Xét duyệt đăng ký, mã tham dự, check-in, điểm danh. *@
@model HTquanlyhoinghi_UNETI2_TI17A3HN.Models.Module4.DuyetDangKyViewModel

@{
    ViewData["Title"] = "Xét duyệt đăng ký";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Quản lý đăng ký sự kiện</h1>
        <p class="text-muted mb-0">Tra cứu, lọc và xử lý trạng thái đăng ký tham dự.</p>
    </div>
    <a class="btn btn-outline-primary" asp-controller="CheckIn" asp-action="Index">Mở check-in</a>
    <a class="btn btn-outline-secondary" asp-controller="DiemDanhPhien" asp-action="Index">Điểm danh phiên</a>
</div>

@if (TempData["ThongBaoModule4"] is string thongBao)
{
    <div class="alert alert-success" role="status">@thongBao</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ThongBao))
{
    <div class="alert alert-warning" role="status">@Model.ThongBao</div>
}

<form asp-action="Index" method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label for="tuKhoa" class="form-label">Tìm kiếm</label>
            <input id="tuKhoa" name="tuKhoa" value="@Model.TuKhoa" class="form-control"
                   placeholder="Mã, tên hoặc email" />
        </div>
        <div class="col-md-3">
            <label for="maSuKien" class="form-label">Sự kiện</label>
            <select id="maSuKien" name="maSuKien" class="form-select">
                <option value="">Tất cả sự kiện</option>
                @foreach (var suKien in Model.DanhSachSuKien)
                {
                    <option value="@suKien.MaSuKien" selected="@(suKien.MaSuKien == Model.MaSuKien)">
                        @suKien.TenSuKien
                    </option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label for="trangThai" class="form-label">Trạng thái</label>
            <select id="trangThai" name="trangThai" class="form-select">
                <option value="">Tất cả trạng thái</option>
                @foreach (var trangThai in Enum.GetValues<HTquanlyhoinghi_UNETI2_TI17A3HN.Models.TrangThaiDangKy>())
                {
                    <option value="@trangThai" selected="@(Model.TrangThai == trangThai)">
                        @(trangThai switch
                        {
                            HTquanlyhoinghi_UNETI2_TI17A3HN.Models.TrangThaiDangKy.ChoDuyet => "Chờ duyệt",
                            HTquanlyhoinghi_UNETI2_TI17A3HN.Models.TrangThaiDangKy.DaDuyet => "Đã duyệt",
                            HTquanlyhoinghi_UNETI2_TI17A3HN.Models.TrangThaiDangKy.DaCheckIn => "Đã check-in",
                            HTquanlyhoinghi_UNETI2_TI17A3HN.Models.TrangThaiDangKy.HoanThanh => "Hoàn thành",
                            HTquanlyhoinghi_UNETI2_TI17A3HN.Models.TrangThaiDangKy.TuChoi => "Từ chối",
                            HTquanlyhoinghi_UNETI2_TI17A3HN.Models.TrangThaiDangKy.DaHuy => "Đã hủy",
                            _ => trangThai.ToString()
                        })
                    </option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Lọc</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
        </div>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th scope="col">Mã đăng ký</th>
                <th scope="col">Người tham dự</th>
                <th scope="col">Email</th>
                <th scope="col">Sự kiện</th>
                <th scope="col">Trạng thái</th>
                <th scope="col">Mã tham dự</th>
                <th scope="col" class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.DanhSachDangKy.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">Không tìm thấy đăng ký phù hợp.</td>
                </tr>
            }
            else
            {
                @foreach (var dangKy in Model.DanhSachDangKy)
                {
                    <tr>
                        <td>@dangKy.MaDangKy</td>
                        <td>@dangKy.TenNguoiThamDu</td>
                        <td>@dangKy.Email</td>
                        <td>@dangKy.TenSuKien</td>
                        <td>
                            <span class="badge @(dangKy.TrangThai == "ChoDuyet" ? "text-bg-warning" :
                                dangKy.TrangThai == "DaHuy" || dangKy.TrangThai == "TuChoi" ? "text-bg-secondary" :
                                "text-bg-success")">
                                @(dangKy.TrangThai switch
                                {
                                    "ChoDuyet" => "Chờ duyệt",
                                    "DaDuyet" => "Đã duyệt",
                                    "DaCheckIn" => "Đã check-in",
                                    "HoanThanh" => "Hoàn thành",
                                    "TuChoi" => "Từ chối",
                                    "DaHuy" => "Đã hủy",
                                    _ => dangKy.TrangThai
                                })
                            </span>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(dangKy.MaThamDu) ? "-" : dangKy.MaThamDu)</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="ChiTiet" asp-route-maDangKy="@dangKy.MaDangKy">Xem</a>
                            @if (dangKy.TrangThai == "ChoDuyet")
                            {
                                <a class="btn btn-sm btn-success" asp-action="Duyet" asp-route-maDangKy="@dangKy.MaDangKy">Duyệt</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="TuChoi" asp-route-maDangKy="@dangKy.MaDangKy">Từ chối</a>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>