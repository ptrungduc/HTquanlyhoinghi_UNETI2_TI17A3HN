@* Họ và tên: [TÊN CỦA TÔI] *@
@* Mã sinh viên: [MSSV CỦA TÔI] *@
@* Nội dung thực hiện: Module 4 - Xét duyệt đăng ký, mã tham dự, check-in, điểm danh. *@
@model HTquanlyhoinghi_UNETI2_TI17A3HN.Models.Module4.XacNhanDuyetDangKyViewModel

@{
    ViewData["Title"] = "Xác nhận duyệt";
    var ketQua = ViewBag.KetQuaThaoTac as HTquanlyhoinghi_UNETI2_TI17A3HN.Models.Module4.KetQuaThaoTacViewModel;
}

<h1 class="h3 mb-4">Xác nhận duyệt đăng ký</h1>

@if (ketQua is not null)
{
    <div class="alert @(ketQua.ThanhCong ? "alert-success" : "alert-danger")" role="status">@ketQua.ThongBao</div>
}

<div class="alert alert-warning" role="status">Service sẽ kiểm tra lại trạng thái đăng ký và sức chứa trước khi duyệt.</div>

<form asp-action="Duyet" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <span>Mã đăng ký: <code>@Model.MaDangKy</code></span>
        <input asp-for="MaDangKy" type="hidden" />
    </div>
    <button type="submit" class="btn btn-success">Xác nhận duyệt</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
</form>