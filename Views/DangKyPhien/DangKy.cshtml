@{
    ViewData["Title"] = "Đăng ký phiên sự kiện";
    string maPhien = ViewBag.MaPhien?.ToString() ?? "";
}

<h2>Đăng ký phiên sự kiện</h2>

@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger">
        @TempData["Loi"]
    </div>
}

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success">
        @TempData["ThongBao"]
    </div>
}

<form asp-action="DangKy" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden"
           name="maPhien"
           value="@maPhien" />

    <div class="mb-3">
    </div>

    <button type="submit"
            class="btn btn-primary">
        Đăng ký phiên này
    </button>
</form>