@using HTquanlyhoinghi_UNETI2_TI17A3HN.Models
@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    var hoTen = Context.Session.GetString("HoTen") ?? "Ban Quản Trị";
}

<!-- Header -->
<header class="admin-header">

    <div>
        <h2>Trang chủ</h2>
        <p>Quản lý hệ thống sự kiện &amp; hội nghị</p>
    </div>
    
</header>


<!-- Xin chào -->
<section class="welcome-box">

    <div>
        <h1>Xin chào, @hoTen! 👋</h1>

        <p>
            Chào mừng bạn quay trở lại hệ thống quản lý
            sự kiện và hội nghị.
        </p>
    </div>

    <div class="welcome-icon">
        📅
    </div>

</section>


<!-- Thống kê -->
<section class="stat-grid">

    <div class="stat-card" onclick="window.location.href='/SuKien/Index';">
        <div class="stat-icon blue">
            📅
        </div>

        <div>
            <span>Tổng sự kiện</span>
            <strong>@Model.TongSuKien</strong>
            <small>sự kiện trong hệ thống</small>
        </div>
    
    </div>


    <div class="stat-card" onclick="window.location.href='/NguoiThamDu/Index';">
        <div class="stat-icon purple">
            👥
        </div>

        <div>
            <span>Người tham dự</span>
            <strong>@Model.TongNguoiThamDu</strong>
            <small>người đã đăng ký</small>
        </div>
    </div>


    <div class="stat-card" onclick="window.location.href='/DiaDiem/Index';">
        <div class="stat-icon green">
            📍
        </div>

        <div>
            <span>Địa điểm</span>
            <strong>@Model.TongDiaDiem</strong>
            <small>địa điểm tổ chức</small>
        </div>
    </div>


    <div class="stat-card" onclick="window.location.href='/BaoCao/Index';">
        <div class="stat-icon orange">
            📄
        </div>

        <div>
            <span>Tài liệu</span>
            <strong>Báo cáo &amp; Thống kê</strong>
            <small>@Model.TongDangKy đăng ký tham dự</small>
        </div>
    </div>

</section>


<!-- Hai khu vực -->
<section class="dashboard-grid">

    <!-- Sự kiện sắp tới -->
    <div class="dashboard-card">

        <div class="card-header">
            <h3>📅 Sự kiện sắp tới</h3>

            <a href="/SuKien/Index">
                Xem tất cả →
            </a>
        </div>


        <div class="event-list">

            @if (Model.SuKienSapTois.Any())
            {
                @foreach (var sk in Model.SuKienSapTois)
                {
                    <div class="event-item" style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid #eee;">
                        <div>
                            <strong>
                                <a href="/SuKien/Details/@sk.MaSuKien" style="text-decoration: none; color: #333;">
                                    @sk.TenSuKien
                                </a>
                            </strong>
                            <br />
                            <small style="color: #888;">
                                📅 @sk.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm") &nbsp; | &nbsp;
                                📍 @sk.TenDiaDiem
                            </small>
                        </div>
                        <div>
                            @if (sk.SoNgayConLai == 0)
                            {
                                <span class="badge" style="background-color: #e74c3c; color: #fff; padding: 4px 10px; border-radius: 12px; font-size: 0.85em;">
                                    Hôm nay
                                </span>
                            }
                            else if (sk.SoNgayConLai == 1)
                            {
                                <span class="badge" style="background-color: #f39c12; color: #fff; padding: 4px 10px; border-radius: 12px; font-size: 0.85em;">
                                    Ngày mai
                                </span>
                            }
                            else
                            {
                                <span class="badge" style="background-color: #3498db; color: #fff; padding: 4px 10px; border-radius: 12px; font-size: 0.85em;">
                                    Còn @sk.SoNgayConLai ngày
                                </span>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div style="text-align: center; padding: 30px 0; color: #999;">
                    <p style="font-size: 2em;">📭</p>
                    <p>Hiện chưa có sự kiện sắp tới</p>
                </div>
            }

        </div>

    </div>


    <!-- Thao tác nhanh -->
    <div class="dashboard-card">

        <div class="card-header">
            <h3>⚡ Thao tác nhanh</h3>
        </div>


        <div class="quick-actions">

            <a href="/SuKien/Create">
                <span>📅</span>
                <strong>Tạo sự kiện mới</strong>
                <small>Tạo một sự kiện</small>
            </a>

            <a href="/DiaDiem/Create">
                <span>📍</span>
                <strong>Thêm địa điểm</strong>
                <small>Đăng ký địa điểm</small>
            </a>

            <a href="/NguoiThamDu/Index">
                <span>👥</span>
                <strong>Quản lý người tham dự</strong>
                <small>Xem danh sách</small>
            </a>

            <a href="/BaoCao/Index">
                <span>📊</span>
                <strong>Xem báo cáo</strong>
                <small>Thống kê hệ thống</small>
            </a>

        </div>

    </div>

</section>


<!-- Bảng sự kiện -->
<section class="dashboard-card">

    <div class="card-header">

        <h3>📋 Danh sách sự kiện gần đây</h3>

        <a href="/SuKien/Index">
            Xem tất cả →
        </a>

    </div>


    <div class="table-container">

        <table class="event-table">

            <thead>
                <tr>
                    <th>Tên sự kiện</th>
                    <th>Thời gian</th>
                    <th>Địa điểm</th>
                    <th>Người tham dự</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.SuKienGanDays.Any())
                {
                    @foreach (var sk in Model.SuKienGanDays)
                    {
                        <tr>
                            <td>
                                <a href="/SuKien/Details/@sk.MaSuKien" style="text-decoration: none; color: #2980b9; font-weight: 600;">
                                    @sk.TenSuKien
                                </a>
                            </td>
                            <td>@sk.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@sk.TenDiaDiem</td>
                            <td>
                                <span style="font-weight: 600;">@sk.SoNguoiDangKy</span> người
                            </td>
                            <td>
                                @{
                                    var badgeColor = sk.TrangThai switch
                                    {
                                        nameof(TrangThaiSuKien.Nhap) => "background-color: #95a5a6;",
                                        nameof(TrangThaiSuKien.MoDangKy) => "background-color: #3498db;",
                                        nameof(TrangThaiSuKien.DongDangKy) => "background-color: #f39c12;",
                                        nameof(TrangThaiSuKien.DangDienRa) => "background-color: #27ae60;",
                                        nameof(TrangThaiSuKien.HoanThanh) => "background-color: #2c3e50;",
                                        nameof(TrangThaiSuKien.DaHuy) => "background-color: #e74c3c;",
                                        _ => "background-color: #bdc3c7;"
                                    };

                                    var badgeText = sk.TrangThai switch
                                    {
                                        nameof(TrangThaiSuKien.Nhap) => "Nháp",
                                        nameof(TrangThaiSuKien.MoDangKy) => "Mở đăng ký",
                                        nameof(TrangThaiSuKien.DongDangKy) => "Đóng đăng ký",
                                        nameof(TrangThaiSuKien.DangDienRa) => "Đang diễn ra",
                                        nameof(TrangThaiSuKien.HoanThanh) => "Hoàn thành",
                                        nameof(TrangThaiSuKien.DaHuy) => "Đã hủy",
                                        _ => sk.TrangThai
                                    };
                                }
                                <span class="badge" style="@badgeColor color: #fff; padding: 4px 12px; border-radius: 12px; font-size: 0.85em; white-space: nowrap;">
                                    @badgeText
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="text-align: center; padding: 20px; color: #999;">
                            Chưa có sự kiện nào trong hệ thống.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</section>
