@model IEnumerable<HTquanlyhoinghi_UNETI2_TI17A3HN.Models.PhienSuKien>
@{ var suKien = (HTquanlyhoinghi_UNETI2_TI17A3HN.Models.SuKien)ViewBag.SuKien; ViewData["Title"] = "Phiên sự kiện"; }
<h1>Phiên: @suKien.TenSuKien</h1>
<form method="get" class="row g-2 mb-3"><input type="hidden" name="maSuKien" value="@suKien.MaSuKien" /><div class="col-md-8"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo tên phiên, diễn giả hoặc nội dung" /></div><div class="col-md-4"><button class="btn btn-primary" type="submit">Tìm kiếm</button> <a asp-action="Create" asp-route-maSuKien="@suKien.MaSuKien" class="btn btn-success">Thêm phiên</a></div></form>
<table class="table table-bordered"><thead><tr><th>Tên phiên</th><th>Thời gian</th><th>Diễn giả</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var item in Model) {<tr><td>@item.TenPhien</td><td>@item.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm") - @item.ThoiGianKetThuc.ToString("HH:mm")</td><td>@item.DienGia</td><td>@item.TrangThai</td><td><a asp-action="Edit" asp-route-id="@item.MaPhienSuKien">Sửa</a> <form asp-action="Delete" asp-route-id="@item.MaPhienSuKien" asp-route-maSuKien="@suKien.MaSuKien" method="post" class="d-inline"><button class="btn btn-link p-0" type="submit">Xóa</button></form></td></tr>}</tbody></table>
<a asp-controller="SuKien" asp-action="Details" asp-route-id="@suKien.MaSuKien">Quay lại sự kiện</a>
