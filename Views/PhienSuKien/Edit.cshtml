<h1>Sửa phiên - @suKien.TenSuKien</h1><form asp-action="Edit" asp-route-id="@Model.MaPhienSuKien" method="post"><partial name="_Form" model="Model" /><button type="submit" class="btn btn-primary">Lưu thay đổi</button> <a asp-action="Index" asp-route-maSuKien="@Model.MaSuKien" class="btn btn-secondary">Hủy</a></form>
