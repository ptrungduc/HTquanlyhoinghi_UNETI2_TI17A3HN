@model HTquanlyhoinghi_UNETI2_TI17A3HN.Models.LoaiSuKien

@{
    ViewData["Title"] = "Thêm loại sự kiện";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <h2 class="fw-bold mb-4">
                Thêm loại sự kiện
            </h2>

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="mb-3">

                    <label asp-for="MaLoaiSuKien"
                           class="form-label">
                        Mã loại sự kiện
                    </label>

                    <input asp-for="MaLoaiSuKien"
                           class="form-control"
                           placeholder="VD: LSK001" />

                    <span asp-validation-for="MaLoaiSuKien"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="TenLoaiSuKien"
                           class="form-label">
                        Tên loại sự kiện
                    </label>

                    <input asp-for="TenLoaiSuKien"
                           class="form-control"
                           placeholder="VD: Hội nghị" />

                    <span asp-validation-for="TenLoaiSuKien"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="MoTa"
                           class="form-label">
                        Mô tả
                    </label>

                    <textarea asp-for="MoTa"
                              class="form-control"
                              rows="4"
                              placeholder="Nhập mô tả loại sự kiện...">
                    </textarea>

                    <span asp-validation-for="MoTa"
                          class="text-danger">
                    </span>

                </div>


                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Lưu
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Quay lại
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}