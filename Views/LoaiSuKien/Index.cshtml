@model IEnumerable<HTquanlyhoinghi_UNETI2_TI17A3HN.Models.LoaiSuKien>

@{
    ViewData["Title"] = "Quản lý loại sự kiện";
    var sortBy = ViewBag.SortBy as string ?? "TenLoaiSuKien";
    var sortDescending = ViewBag.SortDescending as bool? ?? false;
    var pageNumber = (int)(ViewBag.PageNumber ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 10);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? Model.Count());
}

<!-- Header -->
<header class="admin-header">

    <div>
        <h2>Quản lý loại sự kiện</h2>
        <p>Quản lý các loại sự kiện trong hệ thống</p>
    </div>

    <div class="admin-account">

        <div class="admin-avatar">
            A
        </div>

        <div>
            <strong>Admin</strong>
            <small>Quản trị viên</small>
        </div>

    </div>

</header>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <a asp-action="Create" class="btn btn-primary">
            + Thêm loại sự kiện
        </a>
    </div>

    <form method="get" class="row g-3 mb-3">
        <div class="col-md-5">
            <input name="search" value="@ViewBag.Search" class="form-control"
                   placeholder="Tìm mã, tên hoặc mô tả loại sự kiện" />
        </div>
        <div class="col-md-3">
            <select name="trangThai" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="true" selected="@(ViewBag.TrangThai == "true")">Đang hoạt động</option>
                <option value="false" selected="@(ViewBag.TrangThai == "false")">Đã ngừng hoạt động</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="sortBy" class="form-select">
                <option value="TenLoaiSuKien" selected="@(sortBy == "TenLoaiSuKien")">Tên loại sự kiện</option>
                <option value="MaLoaiSuKien" selected="@(sortBy == "MaLoaiSuKien")">Mã loại sự kiện</option>
                <option value="TrangThai" selected="@(sortBy == "TrangThai")">Trạng thái</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <select name="sortDescending" class="form-select">
                <option value="false" selected="@(!sortDescending)">Tăng dần</option>
                <option value="true" selected="@(sortDescending)">Giảm dần</option>
            </select>
            <button class="btn btn-primary" type="submit">Lọc &amp; sắp</button>
        </div>
    </form>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>
                            <th>Mã loại</th>
                            <th>Tên loại sự kiện</th>
                            <th>Mô tả</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @item.MaLoaiSuKien
                                        </strong>
                                    </td>

                                    <td>
                                        @item.TenLoaiSuKien
                                    </td>

                                    <td>
                                        @(string.IsNullOrEmpty(item.MoTa)
                                            ? "Không có mô tả"
                                            : item.MoTa)
                                    </td>

                                    <td>

                                        @if (item.TrangThai)
                                        {
                                            <span class="badge bg-success">
                                                Hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Ngừng hoạt động
                                            </span>
                                        }

                                    </td>

                                    <td class="text-center">

                                        <a asp-action="Edit" asp-route-id="@item.MaLoaiSuKien"
                                           class="btn btn-sm btn-outline-primary">
                                            Sửa
                                        </a>


                                        @if (item.TrangThai)
                                        {
                                            <form asp-action="NgungHoatDong" asp-route-id="@item.MaLoaiSuKien" method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Bạn có chắc muốn ngừng hoạt động loại sự kiện này?');">
                                                    Ngừng hoạt động
                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="KichHoat" asp-route-id="@item.MaLoaiSuKien" method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="btn btn-sm btn-outline-success">
                                                    Kích hoạt
                                                </button>

                                            </form>
                                        }

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">

                                    Chưa có loại sự kiện nào.

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-3" aria-label="Phân trang loại sự kiện">
            <ul class="pagination justify-content-center">
                <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-route-pageNumber="@(pageNumber - 1)" asp-route-search="@ViewBag.Search"
                       asp-route-trangThai="@ViewBag.TrangThai" asp-route-sortBy="@sortBy"
                       asp-route-sortDescending="@sortDescending">Trước</a>
                </li>
                <li class="page-item active"><span class="page-link">Trang @pageNumber / @totalPages</span></li>
                <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-route-pageNumber="@(pageNumber + 1)" asp-route-search="@ViewBag.Search"
                       asp-route-trangThai="@ViewBag.TrangThai" asp-route-sortBy="@sortBy"
                       asp-route-sortDescending="@sortDescending">Sau</a>
                </li>
            </ul>
        </nav>
    }

</div>