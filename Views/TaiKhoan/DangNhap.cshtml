@model HTquanlyhoinghi_UNETI2_TI17A3HN.Models.DangNhapViewModels

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuanLyHoiNghi</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body style="margin-bottom: 0;">

    <div class="login-page">
        <h1>Hệ Thống Quản Lý Hội Nghị &amp; Sự Kiện</h1>
        <h3>Quản lý chuyên nghiệp - Tổ chức hiệu quả</h3>

        <div class="login-overlay"></div>

        <div class="login-box">

            <div class="text-center mb-4">
                <h2>Đăng nhập</h2>
                <p>Vui lòng nhập thông tin tài khoản của bạn</p>
            </div>

            <form asp-action="DangNhap" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="TenDangNhap" class="form-label">
                        Tên tài khoản
                    </label>

                    <input asp-for="TenDangNhap"
                           class="form-control"
                           placeholder="Nhập tên tài khoản" />

                    <span asp-validation-for="TenDangNhap"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">
                        Email
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="Nhập địa chỉ email" />

                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MatKhau" class="form-label">
                        Mật khẩu
                    </label>

                    <input asp-for="MatKhau"
                           type="password"
                           class="form-control"
                           placeholder="Nhập mật khẩu" />

                    <span asp-validation-for="MatKhau"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <a asp-action="QuenMatKhau" class="text-decoration-none">
                        Quên mật khẩu?
                    </a>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    Đăng nhập
                </button>
            </form>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

</body>

</html>