<!DOCTYPE html>
<html lang="@(Context.Request.Cookies["ngon_ngu"] == "en" ? "en" : "vi")">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - QuanLyHoiNghi</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/QuanLyHoiNghi.styles.css"
          asp-append-version="true" />
</head>

@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    // Cài đặt người dùng (cookie) từ trang Cài đặt
    var ngonNguTrang = Context.Request.Cookies["ngon_ngu"] == "en" ? "en" : "vi";
    var themeTrang = Context.Request.Cookies["theme"] == "dark" ? "theme-dark" : "";
}

<body class="@themeTrang">

    <div class="admin-page">

        <!-- =====================================
             SIDEBAR
             ===================================== -->

        <aside class="admin-sidebar">

            <!-- LOGO -->
            <div class="admin-logo">

                <div class="logo-icon">
                    📅
                </div>

                <div>
                    <strong>Hệ Thống Quản Lý</strong>
                    <span>Sự Kiện &amp; Hội Nghị</span>
                </div>

            </div>


            <!-- =================================
                 MENU
                 ================================= -->

            <nav class="admin-menu">

                <!-- TRANG CHỦ -->
                <a asp-controller="Admin"
                   asp-action="Index"
                   class="@(currentController == "Admin" ? "active" : "")">
                    🏠
                    <span>Trang chủ</span>
                </a>


                <!-- QUẢN LÝ SỰ KIỆN -->
                <a asp-controller="LoaiSuKien"
                   asp-action="Index">
                    📅
                    <span>Quản lý loại sự kiện</span>
                </a>

                <a asp-controller="SuKien"
                   asp-action="Index"
                   class="@(currentController == "SuKien" ? "active" : "")">
                    🗓️
                    <span>Quản lý sự kiện</span>
                </a>


                <!-- ĐỊA ĐIỂM -->
                <a asp-controller="DiaDiem"
                   asp-action="Index"
                   class="@(currentController == "DiaDiem" ? "active" : "")">
                    📍
                    <span>Địa điểm</span>
                </a>


                <!-- NGƯỜI THAM DỰ -->
                <a asp-controller="NguoiThamDu"
                   asp-action="Index"
                   class="@(currentController == "NguoiThamDu" ? "active" : "")">
                    👥
                    <span>Người tham dự</span>
                </a>

                <a asp-controller="DangKy"
                   asp-action="Index"
                   class="@(currentController == "DangKy" ? "active" : "")">
                    📝
                   <span>Quản lý đăng ký</span>
                </a>

                <!-- MODULE 4 -->
                <a asp-controller="DangKyThamDu"
                   asp-action="Index"
                   class="@(currentController == "DangKyThamDu" ? "active" : "")">
                    ✅
                    <span>Duyệt đăng ký / Cấp mã tham dự</span>
                </a>

                <a asp-controller="CheckIn"
                   asp-action="Index"
                   class="@(currentController == "CheckIn" ? "active" : "")">
                    🎟️
                    <span>Check-in tham dự</span>
                </a>

                <a asp-controller="DiemDanhPhien"
                   asp-action="Index"
                   class="@(currentController == "DiemDanhPhien" ? "active" : "")">
                    📋
                    <span>Điểm danh phiên</span>
                </a>


                <!-- LỊCH TRÌNH -->
                <a asp-controller="LichTrinh"
                   asp-action="Index"
                   class="@(currentController == "LichTrinh" ? "active" : "")">
                    🕐
                    <span>Lịch trình</span>
                </a>

                <!-- BÁO CÁO -->
                <a asp-controller="BaoCao"
                   asp-action="Index"
                   class="@(currentController == "BaoCao" ? "active" : "")">
                    📊
                    <span>Báo cáo</span>
                </a>


                <!-- DASHBOARD (MODULE 5) -->
                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="@(currentController == "Dashboard" ? "active" : "")">
                    📈
                    <span>Dashboard</span>
                </a>


                <!-- THỐNG KÊ (MODULE 5) -->
                <a asp-controller="ThongKe"
                   asp-action="Index"
                   class="@(currentController == "ThongKe" ? "active" : "")">
                    🏆
                    <span>Thống kê &amp; Tỷ lệ</span>
                </a>


                <!-- LỊCH SỬ (MODULE 5) -->
                <a asp-controller="LichSu"
                   asp-action="CaNhan"
                   class="@(currentController == "LichSu" ? "active" : "")">
                    ⏳
                    <span>Lịch sử tham dự</span>
                </a>


                <!-- CÀI ĐẶT -->
                <a asp-controller="CaiDat"
                   asp-action="Index"
                   class="@(currentController == "CaiDat" ? "active" : "")">
                    ⚙️
                    <span>Cài đặt</span>
                </a>

            </nav>

        </aside>


        <!-- =====================================
             MAIN CONTENT
             ===================================== -->

        <main class="admin-content">

            @RenderBody()

        </main>

    </div>


    <!-- =====================================
         JAVASCRIPT
         ===================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>