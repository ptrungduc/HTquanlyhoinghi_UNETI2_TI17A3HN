@* Họ và tên: [TÊN CỦA TÔI] *@
@* Mã sinh viên: [MSSV CỦA TÔI] *@
@* Nội dung thực hiện: Module 4 - Xét duyệt đăng ký, mã tham dự, check-in, điểm danh. *@
@model HTquanlyhoinghi_UNETI2_TI17A3HN.Models.Module4.CheckInViewModel

@{
    ViewData["Title"] = "Check-in tham dự";
    var vaiTro = Context.Session.GetString("VaiTro");
    bool laLeTan = string.Equals(vaiTro, "Le Tan", StringComparison.OrdinalIgnoreCase);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">🎟️ Check-in tham dự</h1>
        <p class="text-muted mb-0">Quét mã tham dự hoặc chọn từ danh sách người tham dự đã duyệt</p>
    </div>
    <div class="d-flex gap-2">
        @if (laLeTan)
        {
            <a class="btn btn-outline-primary" asp-controller="Receptionist" asp-action="Index">
                🛎️ Bàn tiếp đón
            </a>
        }
        else
        {
            <a class="btn btn-outline-secondary" asp-controller="DangKyThamDu" asp-action="Index">
                📋 Xét duyệt đăng ký
            </a>
        }
        <a class="btn btn-outline-secondary" asp-controller="DiemDanhPhien" asp-action="Index">
            📋 Điểm danh phiên
        </a>
    </div>
</div>

@if (Model.KetQua is not null)
{
    <div class="alert @(Model.KetQua.ThanhCong ? "alert-success" : "alert-danger") alert-dismissible fade show shadow-sm" role="status">
        <div class="d-flex align-items-center">
            <span class="fs-4 me-2">@(Model.KetQua.ThanhCong ? "✅" : "⚠️")</span>
            <div>
                <strong>@(Model.KetQua.ThanhCong ? "Check-in thành công!" : "Không thể check-in:")</strong>
                <div>@Model.KetQua.ThongBao</div>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4 mb-4">
    <!-- Cột trái: Form nhập mã Check-in -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0 fs-6 fw-bold">Quét / Nhập mã tham dự</h5>
            </div>
            <div class="card-body p-4">
                <form id="formCheckIn" asp-controller="CheckIn" asp-action="Index" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="MaThamDu" class="form-label fw-semibold">
                            Mã tham dự <span class="text-danger">*</span>
                        </label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light">
                                🎟️
                            </span>
                            <input asp-for="MaThamDu" id="inputMaThamDu" class="form-control form-control-lg font-monospace"
                                   placeholder="Ví dụ: TD-0015, UN-..." autofocus autocomplete="off" />
                        </div>
                        <span asp-validation-for="MaThamDu" class="text-danger"></span>
                        <div class="form-text">
                            Hỗ trợ quét đầu đọc mã vạch / QR scanner (tự động điền mã).
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="GhiChu" class="form-label fw-semibold"></label>
                        <textarea asp-for="GhiChu" id="inputGhiChu" class="form-control" rows="2"
                                  placeholder="Ghi chú thêm (tùy chọn: thẻ khách, tài liệu đã nhận...)"></textarea>
                        <span asp-validation-for="GhiChu" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success btn-lg px-4 fw-bold">
                            ✓ Xác nhận Check-in
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-lg" onclick="document.getElementById('inputMaThamDu').value=''; document.getElementById('inputMaThamDu').focus();">
                            Xóa
                        </button>
                    </div>
                </form>

                @if (Model.DangKy is not null)
                {
                    @if (string.IsNullOrWhiteSpace(Model.DangKy.MaDangKy))
                    {
                        <div class="alert alert-warning mt-3" role="status">@Model.DangKy.ThongBao</div>
                    }
                    else
                    {
                        var trangThaiDangKy = Model.DangKy.TrangThai switch
                        {
                            "ChoDuyet" => "Chờ duyệt",
                            "DaDuyet" => "Đã duyệt",
                            "DaCheckIn" => "Đã check-in",
                            "HoanThanh" => "Hoàn thành",
                            "TuChoi" => "Từ chối",
                            "DaHuy" => "Đã hủy",
                            _ => Model.DangKy.TrangThai
                        };

                        <div class="card mt-3 border">
                            <div class="card-header fw-semibold bg-light">Thông tin đăng ký</div>
                            <div class="card-body">
                                <dl class="row mb-0">
                                    <dt class="col-sm-4">Mã đăng ký</dt>
                                    <dd class="col-sm-8"><code>@Model.DangKy.MaDangKy</code></dd>
                                    <dt class="col-sm-4">Người tham dự</dt>
                                    <dd class="col-sm-8">@Model.DangKy.TenNguoiThamDu</dd>
                                    <dt class="col-sm-4">Email</dt>
                                    <dd class="col-sm-8">@Model.DangKy.Email</dd>
                                    <dt class="col-sm-4">Sự kiện</dt>
                                    <dd class="col-sm-8">@Model.DangKy.TenSuKien</dd>
                                    <dt class="col-sm-4">Trạng thái</dt>
                                    <dd class="col-sm-8">@trangThaiDangKy</dd>
                                    @if (Model.DangKy.NgayCheckIn.HasValue)
                                    {
                                        <dt class="col-sm-4">Đã check-in lúc</dt>
                                        <dd class="col-sm-8">@Model.DangKy.NgayCheckIn.Value.ToString("dd/MM/yyyy HH:mm:ss")</dd>
                                        <dt class="col-sm-4">Người thực hiện</dt>
                                        <dd class="col-sm-8">@Model.DangKy.NguoiCheckIn</dd>
                                    }
                                </dl>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    </div>

    <!-- Cột phải: Hướng dẫn & Thống kê nhanh -->
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fs-6 fw-bold text-dark">ℹ️ Hướng dẫn tiếp đón</h5>
            </div>
            <div class="card-body p-4">
                <ul class="list-unstyled mb-4">
                    <li class="mb-3 d-flex align-items-start">
                        <span class="badge bg-primary me-2 mt-1">1</span>
                        <span>Đại biểu xuất trình vé điện tử, email xác nhận hoặc cung cấp họ tên / SĐT.</span>
                    </li>
                    <li class="mb-3 d-flex align-items-start">
                        <span class="badge bg-primary me-2 mt-1">2</span>
                        <span>Quét mã vạch hoặc nhập <strong>Mã tham dự</strong> vào ô bên trái, sau đó nhấn <strong>Xác nhận Check-in</strong>.</span>
                    </li>
                    <li class="mb-3 d-flex align-items-start">
                        <span class="badge bg-primary me-2 mt-1">3</span>
                        <span>Nếu đại biểu quên mã, có thể tra cứu nhanh trong danh sách bên dưới và nhấn nút <strong>⚡ Check-in ngay</strong>.</span>
                    </li>
                </ul>

                <div class="p-3 bg-light rounded">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Sẵn sàng check-in:</span>
                        <strong class="text-primary">@Model.DanhSachSanSang.Count người</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Đã check-in hôm nay:</span>
                        <strong class="text-success">@Model.DanhSachVuaCheckIn.Count người</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabs danh sách: Sẵn sàng check-in & Lịch sử hôm nay -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-2">
        <ul class="nav nav-tabs card-header-tabs" id="checkInTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-semibold" id="ready-tab" data-bs-toggle="tab" data-bs-target="#ready-pane" type="button" role="tab">
                    👥 Người tham dự sẵn sàng check-in (@Model.DanhSachSanSang.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="history-tab" data-bs-toggle="tab" data-bs-target="#history-pane" type="button" role="tab">
                    🕒 Lịch sử check-in hôm nay (@Model.DanhSachVuaCheckIn.Count)
                </button>
            </li>
        </ul>
    </div>

    <div class="card-body p-3">
        <div class="tab-content" id="checkInTabContent">
            <!-- Tab 1: Sẵn sàng check-in -->
            <div class="tab-pane fade show active" id="ready-pane" role="tabpanel">
                <div class="mb-3">
                    <input type="text" id="boLocSanSang" class="form-control"
                           placeholder="🔍 Lọc nhanh theo Họ tên, SĐT, Email hoặc Mã tham dự..."
                           onkeyup="locBang('boLocSanSang', 'bangSanSang')" />
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="bangSanSang">
                        <thead class="table-light">
                            <tr>
                                <th>Mã tham dự</th>
                                <th>Người tham dự</th>
                                <th>Số điện thoại</th>
                                <th>Sự kiện</th>
                                <th class="text-end">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.DanhSachSanSang.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        Không có người tham dự nào đang chờ check-in cho các sự kiện đang diễn ra hôm nay.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.DanhSachSanSang)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-dark font-monospace fs-6">@item.MaThamDu</span>
                                        </td>
                                        <td>
                                            <div class="fw-bold">@item.HoTen</div>
                                            <small class="text-muted">@item.Email</small>
                                        </td>
                                        <td>@item.SoDienThoai</td>
                                        <td><span class="text-primary fw-semibold">@item.TenSuKien</span></td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-success fw-semibold"
                                                    onclick="thucHienCheckInNhanh('@item.MaThamDu')">
                                                ⚡ Check-in ngay
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tab 2: Lịch sử check-in hôm nay -->
            <div class="tab-pane fade" id="history-pane" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Thời gian</th>
                                <th>Mã tham dự</th>
                                <th>Người tham dự</th>
                                <th>Sự kiện</th>
                                <th>Ghi chú</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.DanhSachVuaCheckIn.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        Chưa có lượt check-in nào trong ngày hôm nay.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var ci in Model.DanhSachVuaCheckIn)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-secondary font-monospace">
                                                @(ci.ThoiGianCheckIn?.ToString("HH:mm:ss") ?? "-")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge bg-dark font-monospace">@ci.MaThamDu</span>
                                        </td>
                                        <td>
                                            <div class="fw-bold">@ci.HoTen</div>
                                            <small class="text-muted">@ci.SoDienThoai</small>
                                        </td>
                                        <td>@ci.TenSuKien</td>
                                        <td>
                                            <small class="text-muted">@(string.IsNullOrWhiteSpace(ci.GhiChu) ? "—" : ci.GhiChu)</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-success">✓ Thành công</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        function thucHienCheckInNhanh(maThamDu) {
            var inputMa = document.getElementById('inputMaThamDu');
            if (inputMa) {
                inputMa.value = maThamDu;
                document.getElementById('formCheckIn').submit();
            }
        }

        function locBang(inputId, tableId) {
            var input = document.getElementById(inputId);
            var filter = input.value.toLowerCase();
            var table = document.getElementById(tableId);
            var trs = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

            for (var i = 0; i < trs.length; i++) {
                var text = trs[i].innerText.toLowerCase();
                if (text.indexOf(filter) > -1) {
                    trs[i].style.display = "";
                } else {
                    trs[i].style.display = "none";
                }
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            var inputMa = document.getElementById("inputMaThamDu");
            if (inputMa) {
                inputMa.focus();
            }
        });
    </script>
}
