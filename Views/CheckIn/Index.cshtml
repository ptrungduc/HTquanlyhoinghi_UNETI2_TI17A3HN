@* Họ và tên: [TÊN CỦA TÔI] *@
@* Mã sinh viên: [MSSV CỦA TÔI] *@
@* Nội dung thực hiện: Module 4 - Xét duyệt đăng ký, mã tham dự, check-in, điểm danh. *@
@model HTquanlyhoinghi_UNETI2_TI17A3HN.Models.Module4.CheckInViewModel

@{
    ViewData["Title"] = "Check-in";
}

<h1 class="h3 mb-4">Check-in tham dự</h1>

@if (Model.KetQua is not null)
{
    <div class="alert @(Model.KetQua.ThanhCong ? "alert-success" : "alert-danger")" role="status">
        @Model.KetQua.ThongBao
    </div>
}
else
{
    <div class="alert alert-info" role="status">Chưa tích hợp Module 3. Check-in chưa được thực hiện.</div>
}

<form asp-controller="CheckIn" asp-action="Index" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="MaThamDu" class="form-label"></label>
        <input asp-for="MaThamDu" class="form-control" autocomplete="off" />
        <span asp-validation-for="MaThamDu" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="GhiChu" class="form-label"></label>
        <textarea asp-for="GhiChu" class="form-control" rows="3"></textarea>
        <span asp-validation-for="GhiChu" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Check-in</button>
    <a class="btn btn-outline-secondary" asp-controller="DangKyThamDu" asp-action="Index">Danh sách xét duyệt</a>
</form>